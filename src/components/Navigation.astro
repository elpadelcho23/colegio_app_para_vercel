---
const { currentPath = '/', spaEnabled = false } = Astro.props;
const user = Astro.locals.user;
const isGuest = Boolean(user?.is_guest);

const spaLinks = [
  { view: 'panel', href: '/', label: 'Panel', shortLabel: 'Panel' },
  { view: 'registro', href: '/registro', label: 'Alumnos', shortLabel: 'Alumnos' },
  { view: 'cursos', href: '/cursos', label: 'Cursos', shortLabel: 'Cursos' },
  { view: 'asistencia', href: '/asistencia', label: 'Asistencia', shortLabel: 'Asist.' },
  { view: 'notas', href: '/notas', label: 'Calificaciones', shortLabel: 'Calificaciones' },
  { view: 'actividades', href: '/actividades', label: 'Actividades', shortLabel: 'Actividades' },
] as const;

const staticLinks = [
  ...(user?.rol === 'admin' ? [{ href: '/admin/usuarios', label: 'Admin' }] : []),
];

const isActive = (href: string) => {
  if (href === '/') return currentPath === '/';
  return currentPath.startsWith(href);
};
---

<header class="app-shell">
  <div class="institution-strip">
    <div>
      <strong>Escuela Técnica 1</strong>
      <span class="institution-strip-secondary">Seguimiento escolar simple para docentes</span>
    </div>
    {user && (
      <button
        type="button"
        class="sync-indicator"
        data-sync-indicator
        aria-label="Estado de sincronización"
        title="Sincronización"
      >
        <span class="sync-indicator-dot" aria-hidden="true"></span>
        <span class="sync-indicator-label" data-sync-indicator-label>Guardado</span>
      </button>
    )}
    {user && (
      <label class="global-cycle-picker global-cycle-picker--strip">
        <span>Ciclo</span>
        <select data-global-cycle aria-label="Ciclo lectivo activo"></select>
      </label>
    )}
    {user && (
      <span class="institution-strip-user">
        <span class="institution-strip-user-name">{user.nombre}</span>
        <span class="institution-strip-user-role"> - {isGuest ? 'invitado' : user.rol}</span>
      </span>
    )}
  </div>
  {isGuest && (
    <div class="guest-banner" role="status" data-guest-banner>
      <strong>Modo invitado</strong>
    </div>
  )}
  <nav class="topbar" aria-label="Navegación principal">
    {spaEnabled ? (
      <button class="brand brand-button" type="button" data-spa-nav="panel" aria-label="Ir al panel principal">
        <span class="brand-mark">AC</span>
        <span>
          <strong>Aula Clara</strong>
          <small>Gestión docente</small>
        </span>
      </button>
    ) : (
      <a class="brand" href="/" aria-label="Ir al panel principal">
        <span class="brand-mark">AC</span>
        <span>
          <strong>Aula Clara</strong>
          <small>Gestión docente</small>
        </span>
      </a>
    )}

    <button
      class="menu-toggle"
      type="button"
      aria-label="Abrir menú"
      aria-controls="main-navigation-menu"
      aria-expanded="false"
      data-menu-toggle
    >
      <span></span>
      <span></span>
      <span></span>
    </button>

    <div class="nav-links" id="main-navigation-menu" data-nav-menu role="menu">
      <div class="nav-links-head">
        <p class="nav-section-label">Menú</p>
        <button type="button" class="nav-links-close btn btn-ghost btn-sm" data-menu-close aria-label="Cerrar menú">
          Cerrar
        </button>
      </div>
      {user && (
        <div class="nav-cycle-picker">
          <label class="global-cycle-picker">
            <span>Ciclo lectivo</span>
            <select data-global-cycle aria-label="Ciclo lectivo activo"></select>
          </label>
        </div>
      )}
      {spaEnabled ? (
        <>
          {spaLinks.map((link) => (
            <button
              type="button"
              class="nav-tab"
              data-spa-nav={link.view}
              role="menuitem"
            >
              {link.label}
            </button>
          ))}
          <p class="nav-section-label nav-section-label--secondary">Avanzado</p>
          <button
            type="button"
            class="nav-tab nav-tab--secondary"
            data-spa-nav="herramientas"
            role="menuitem"
          >
            Excel y cuenta
          </button>
        </>
      ) : (
        <>
          {spaLinks.map((link) => (
            <a
              href={link.href}
              class:list={[{ active: isActive(link.href) }]}
              aria-current={isActive(link.href) ? 'page' : undefined}
              role="menuitem"
            >
              {link.label}
            </a>
          ))}
          <p class="nav-section-label nav-section-label--secondary">Avanzado</p>
          <a
            href="/herramientas"
            class:list={[{ active: isActive('/herramientas') }]}
            aria-current={isActive('/herramientas') ? 'page' : undefined}
            role="menuitem"
          >
            Excel y cuenta
          </a>
        </>
      )}
      {staticLinks.map((link) => (
        <a
          href={link.href}
          class:list={[{ active: isActive(link.href) }]}
          aria-current={isActive(link.href) ? 'page' : undefined}
          role="menuitem"
        >
          {link.label}
        </a>
      ))}
      {user ? (
        <form method="post" action="/api/auth/logout" class="nav-form" data-logout-form>
          <button type="submit">{isGuest ? 'Salir y borrar datos' : 'Salir'}</button>
        </form>
      ) : (
        <a href="/login" class:list={[{ active: currentPath === '/login' }]}>Login</a>
      )}
      <details class="help-menu" data-help-menu>
        <summary class="help-menu-toggle" aria-label="Ayuda">?</summary>
        <div class="help-menu-panel" role="menu">
          <p class="help-menu-title">Ayuda</p>
          <button type="button" class="help-menu-item" role="menuitem" data-product-tour-start>
            ¿Arrancamos con el tutorial?
          </button>
          <button type="button" class="help-menu-item" role="menuitem" data-pwa-install-btn>
            Instalar app (PC / Android)
          </button>
          <button type="button" class="help-menu-item" role="menuitem" data-gtc-open>
            Cambiar curso actual
          </button>
        </div>
      </details>
      <button class="theme-toggle" type="button" data-theme-toggle>Modo oscuro</button>
    </div>
  </nav>

  {user && (
    <div class="global-teaching-context" data-global-teaching-context>
      <div class="gtc-summary-row">
        <div class="gtc-summary">
          <span class="gtc-label">Curso actual</span>
          <strong data-gtc-summary>Elegí curso y materia</strong>
          <span class="gtc-hint is-hidden" data-gtc-hint hidden>Se usa en Asistencia, Notas y Actividades</span>
        </div>
        <button type="button" class="btn btn-secondary btn-sm" data-gtc-toggle>
          Cambiar
        </button>
      </div>
      <div class="context-gate context-gate--inline is-hidden" data-gtc-gate hidden>
        <p>Elegí <strong>curso</strong> y <strong>materia</strong> para usar la app.</p>
        <button type="button" class="btn btn-primary btn-sm" data-gtc-open>Elegir ahora</button>
      </div>
      <form class="gtc-form is-hidden" data-gtc-form hidden>
        <label>
          <span>Escuela</span>
          <select name="escuela" data-gtc-school aria-label="Escuela activa"></select>
        </label>
        <label>
          <span>Curso</span>
          <select name="curso" data-gtc-course aria-label="Curso activo" required></select>
        </label>
        <label>
          <span>Materia</span>
          <select name="materia" data-gtc-subject aria-label="Materia activa" required></select>
        </label>
        <button type="submit" class="btn btn-primary btn-sm">Usar este curso</button>
      </form>
    </div>
  )}
</header>

<style>
  .brand-button {
    border: 0;
    background: transparent;
    cursor: pointer;
    text-align: left;
    color: inherit;
    font: inherit;
    padding: 0;
  }

  .nav-tab {
    border: 0;
    background: transparent;
    color: inherit;
    font: inherit;
    cursor: pointer;
    text-align: left;
    width: 100%;
    padding: 0.65rem 0.85rem;
    border-radius: var(--radius-sm);
  }

  .nav-tab.active,
  .nav-tab[aria-current='page'] {
    background: color-mix(in srgb, var(--brand) 14%, var(--surface));
    color: var(--brand);
    font-weight: 700;
  }

  .nav-section-label--secondary {
    margin-top: 0.65rem;
    font-size: 0.72rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--muted, #5f6b66);
  }

  .nav-tab--secondary {
    color: var(--muted, #5f6b66);
    font-size: 0.95rem;
  }

  .sync-indicator {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    min-height: 2rem;
    width: auto;
    max-width: 11rem;
    padding: 0.25rem 0.55rem 0.25rem 0.45rem;
    border: 1px solid var(--line, #d9e1dc);
    border-radius: 999px;
    background: var(--surface, #fff);
    cursor: pointer;
    color: var(--muted, #5f6b66);
    font: inherit;
    font-size: 0.72rem;
    font-weight: 700;
  }

  .sync-indicator-label {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .sync-indicator-dot {
    flex: 0 0 auto;
    width: 0.65rem;
    height: 0.65rem;
    border-radius: 999px;
    background: var(--ok, #1f7a4d);
  }

  .sync-indicator[data-sync-state='pending'] .sync-indicator-dot {
    background: #c98a12;
  }

  .sync-indicator[data-sync-state='error'] .sync-indicator-dot {
    background: var(--danger, #b42318);
  }

  .sync-indicator[data-sync-state='offline'] .sync-indicator-dot {
    background: #6b7280;
  }

  @media (max-width: 640px) {
    .sync-indicator-label {
      display: none;
    }

    .sync-indicator {
      width: 2rem;
      max-width: none;
      padding: 0;
      justify-content: center;
    }
  }

  .global-cycle-picker {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-size: 0.82rem;
    color: var(--muted, #5f6b66);
  }

  .global-cycle-picker select {
    min-width: 6.5rem;
    min-height: var(--tap);
    padding: 0.45rem 0.55rem;
    border-radius: 0.45rem;
    border: 1px solid var(--line, #d9e1dc);
    background: var(--surface, #fff);
    font: inherit;
    color: inherit;
  }

  .nav-cycle-picker {
    display: none;
  }

  .nav-cycle-picker .global-cycle-picker {
    display: grid;
    gap: 0.35rem;
    width: 100%;
    padding: 0 0.85rem;
  }

  .nav-cycle-picker .global-cycle-picker select {
    width: 100%;
  }

  .global-teaching-context {
    width: min(var(--content-max, 1120px), calc(100% - 24px));
    margin: 0 auto;
    padding: 0.55rem 0.75rem 0.75rem;
    border-bottom: 1px solid var(--line, #d9e1dc);
    background: color-mix(in srgb, var(--surface, #fff) 92%, var(--bg, #f3f6f4));
  }

  .gtc-summary-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
  }

  .gtc-summary {
    display: grid;
    gap: 0.1rem;
    min-width: 0;
  }

  .gtc-label {
    font-size: 0.72rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--muted, #5f6b66);
  }

  .gtc-summary strong {
    font-size: 1.05rem;
    line-height: 1.3;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .gtc-hint {
    font-size: 0.78rem;
    color: var(--muted, #5f6b66);
  }

  .global-teaching-context.gtc--needs-context {
    border-bottom-color: color-mix(in srgb, var(--warning, #c47b1a) 45%, var(--line, #d9e1dc));
    background: color-mix(in srgb, var(--warning, #c47b1a) 8%, var(--surface, #fff));
  }

  .global-teaching-context.gtc--needs-context .gtc-summary strong {
    color: color-mix(in srgb, var(--warning, #c47b1a) 70%, var(--text, #1a1a1a));
  }

  .gtc-form {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
    gap: 0.55rem;
    margin-top: 0.65rem;
    align-items: end;
  }

  .gtc-form label {
    display: grid;
    gap: 0.25rem;
    font-size: 0.82rem;
    color: var(--muted, #5f6b66);
  }

  .gtc-form select {
    min-height: var(--tap, 44px);
    padding: 0.45rem 0.55rem;
    border-radius: 0.45rem;
    border: 1px solid var(--line, #d9e1dc);
    background: var(--surface, #fff);
    font: inherit;
    color: inherit;
  }

  .gtc-form.is-hidden,
  .gtc-form[hidden] {
    display: none;
  }

  @media (max-width: 1023px) {
    .global-cycle-picker--strip {
      display: none;
    }

    .nav-cycle-picker {
      display: block;
      padding-bottom: 0.55rem;
      margin-bottom: 0.35rem;
      border-bottom: 1px solid var(--line, #d9e1dc);
    }

    .global-teaching-context {
      width: 100%;
      margin: 0;
      padding: 0.35rem 0.75rem 0.45rem;
      border-bottom: 1px solid var(--line, #d9e1dc);
      background: color-mix(in srgb, var(--surface, #fff) 96%, var(--bg, #f3f6f4));
    }

    .gtc-summary-row {
      gap: 0.45rem;
      align-items: center;
    }

    .gtc-label {
      font-size: 0.65rem;
      margin: 0;
    }

    .gtc-summary {
      gap: 0;
      min-width: 0;
      flex: 1;
    }

    .gtc-summary strong {
      font-size: 0.86rem;
      line-height: 1.25;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    .gtc-hint {
      display: none;
    }

    .gtc-summary-row .btn {
      flex-shrink: 0;
      min-height: 44px;
      padding: 0.4rem 0.75rem;
      font-size: 0.82rem;
    }

    .gtc-form {
      margin-top: 0.45rem;
      gap: 0.4rem;
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 479px) {
    .global-teaching-context {
      padding: 0.3rem 0.55rem 0.4rem;
    }

    .gtc-summary strong {
      font-size: 0.8rem;
    }
  }

  @media (min-width: 1024px) {
    .global-teaching-context {
      width: 100%;
      margin: 0;
      padding: 0.65rem 0.85rem 0.85rem;
    }
  }
</style>
