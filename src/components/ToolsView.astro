---
import ExcelImportWorkspace from './ExcelImportWorkspace.astro';
---

<header class="page-header">
  <div class="header-content">
    <p class="eyebrow">Operaciones</p>
    <h1>Herramientas</h1>
    <p class="copy-collapse-mobile">Importaciones en lote, cuenta e informes.</p>
  </div>
</header>

<div class="tools-hub-tabs" role="tablist" aria-label="Secciones de herramientas" data-tools-hub-tabs>
  <button
    type="button"
    class="tools-hub-tab is-active"
    role="tab"
    data-tools-hub-tab="importar"
    aria-selected="true"
    aria-controls="tools-hub-importar"
    id="tools-hub-tab-importar"
  >
    <span class="copy-long">Importar Datos</span>
    <span class="copy-short">Importar</span>
  </button>
  <button
    type="button"
    class="tools-hub-tab"
    role="tab"
    data-tools-hub-tab="cuenta"
    aria-selected="false"
    aria-controls="tools-hub-cuenta"
    id="tools-hub-tab-cuenta"
  >
    <span class="copy-long">Cuenta / Instalar</span>
    <span class="copy-short">Cuenta</span>
  </button>
  <button
    type="button"
    class="tools-hub-tab"
    role="tab"
    data-tools-hub-tab="informes"
    aria-selected="false"
    aria-controls="tools-hub-informes"
    id="tools-hub-tab-informes"
  >
    <span class="copy-long">Informes / Comunicados</span>
    <span class="copy-short">Informes</span>
  </button>
</div>

<section
  class="tools-hub-panel"
  id="tools-hub-importar"
  role="tabpanel"
  aria-labelledby="tools-hub-tab-importar"
  data-tools-hub-panel="importar"
  data-tools-section="excel"
>
  <div class="section-title">
    <h2>Importar datos en lote</h2>
    <p>
      Acá centralizás la carga masiva desde Excel:
      <strong>Alumnos</strong>, <strong>Asistencias</strong> y <strong>Notas</strong>.
      Elegí el tipo, subí la planilla y confirmá las columnas.
    </p>
  </div>

  <div class="tools-tabs" role="tablist" aria-label="Tipo de importación Excel">
    <button type="button" class="tools-tab is-active" role="tab" data-tools-tab="alumnos" aria-selected="true" aria-controls="tools-panel-alumnos" id="tools-tab-alumnos">
      Alumnos
    </button>
    <button type="button" class="tools-tab" role="tab" data-tools-tab="asistencias" aria-selected="false" aria-controls="tools-panel-asistencias" id="tools-tab-asistencias">
      Asistencias
    </button>
    <button type="button" class="tools-tab" role="tab" data-tools-tab="notas" aria-selected="false" aria-controls="tools-panel-notas" id="tools-tab-notas">
      Notas
    </button>
  </div>

  <div class="tools-tab-panel" id="tools-panel-alumnos" role="tabpanel" aria-labelledby="tools-tab-alumnos" data-tools-panel="alumnos">
    <ExcelImportWorkspace
      importType="alumnos"
      title="Cargar alumnos"
      description="Subí el Excel y confirmá qué columna es cada dato."
    />
  </div>

  <div class="tools-tab-panel is-hidden" id="tools-panel-asistencias" role="tabpanel" aria-labelledby="tools-tab-asistencias" data-tools-panel="asistencias" hidden>
    <ExcelImportWorkspace
      importType="asistencias"
      title="Cargar asistencias"
      description="Subí la planilla de presentismo y confirmá las columnas."
      submitLabel="Importar asistencias"
    />

    <section class="panel export-panel" data-excel-export="asistencias">
      <div class="section-title">
        <h3>Exportar asistencias</h3>
        <p>Descargá el historial filtrado.</p>
      </div>
      <div class="filters-grid">
        <select data-export-school aria-label="Escuela">
          <option value="">Todas las escuelas</option>
        </select>
        <select data-export-course aria-label="Curso">
          <option value="">Todos los cursos</option>
        </select>
        <select data-export-subject aria-label="Materia">
          <option value="">Todas las materias</option>
        </select>
        <input type="date" data-export-from aria-label="Desde" />
        <input type="date" data-export-to aria-label="Hasta" />
      </div>
      <button class="btn btn-secondary" type="button" data-export-submit>Exportar asistencias</button>
    </section>
  </div>

  <div class="tools-tab-panel is-hidden" id="tools-panel-notas" role="tabpanel" aria-labelledby="tools-tab-notas" data-tools-panel="notas" hidden>
    <ExcelImportWorkspace
      importType="notas"
      title="Cargar notas"
      description="Subí la planilla de calificaciones y confirmá las columnas."
      submitLabel="Importar notas"
    />

    <section class="panel export-panel" data-excel-export="notas">
      <div class="section-title">
        <h3>Exportar notas</h3>
        <p>Descargá calificaciones filtradas.</p>
      </div>
      <div class="filters-grid">
        <select data-export-school aria-label="Escuela">
          <option value="">Todas las escuelas</option>
        </select>
        <select data-export-course aria-label="Curso">
          <option value="">Todos los cursos</option>
        </select>
        <select data-export-subject aria-label="Materia">
          <option value="">Todas las materias</option>
        </select>
        <input type="date" data-export-from aria-label="Desde" />
        <input type="date" data-export-to aria-label="Hasta" />
      </div>
      <button class="btn btn-secondary" type="button" data-export-submit>Exportar notas</button>
    </section>
  </div>
</section>

<section
  class="tools-hub-panel is-hidden"
  id="tools-hub-cuenta"
  role="tabpanel"
  aria-labelledby="tools-hub-tab-cuenta"
  data-tools-hub-panel="cuenta"
  hidden
>
  <section class="panel tools-section" data-tools-section="sync" data-sync-tools>
    <div class="section-title">
      <h2>Sincronización</h2>
      <p>Los cambios se guardan solos. Tocá si ves pendientes.</p>
    </div>

    <div class="sync-line">
      <span class="tag" data-connection-status>Detectando...</span>
      <small class="sync-status" data-sync-status>Todo guardado en la nube</small>
    </div>

    <button class="btn btn-primary" type="button" data-sync-button>Sincronizar ahora</button>
  </section>

  <section class="panel tools-section pwa-install" data-pwa-install data-tools-section="install">
    <div class="section-title">
      <h2>
        <span class="copy-long">Instalar app (PC / Android / iOS)</span>
        <span class="copy-short">Instalar app</span>
      </h2>
      <p class="copy-collapse-mobile">Instalá desde esta web, sin tienda.</p>
    </div>
    <button type="button" class="btn btn-primary" data-pwa-install-btn>
      <span class="copy-long">Instalar en este dispositivo</span>
      <span class="copy-short">Instalar</span>
    </button>
    <p class="muted" data-pwa-install-status></p>
    <details class="pwa-install-help" data-pwa-install-help>
      <summary>Cómo instalar según el dispositivo</summary>
      <ul>
        <li><strong>Android (Chrome):</strong> tocá Instalar, o Menú ⋮ → Instalar app.</li>
        <li><strong>PC (Chrome / Edge):</strong> tocá Instalar, o el ícono ⊕ en la barra de direcciones.</li>
        <li><strong>iPhone / iPad (Safari):</strong> Compartir → Agregar a pantalla de inicio.</li>
      </ul>
    </details>
  </section>

  <section class="panel tools-section" data-tools-section="plan" data-billing-plan>
    <div class="section-title">
      <h2>Plan</h2>
      <p>Asistencia y notas son gratis. Pro suma kit y recuperación con IA.</p>
    </div>
    <div class="metric-grid" data-plan-summary></div>
    <div class="button-row">
      <button type="button" class="btn btn-secondary" data-plan-set="free">Plan gratis</button>
      <button type="button" class="btn btn-secondary" data-plan-set="trial">Prueba 30 días</button>
      <button type="button" class="btn btn-primary" data-plan-set="pro">Plan Pro (demo)</button>
    </div>
  </section>

  <section class="panel tools-section" data-tools-section="kit" data-teacher-kit>
    <div class="section-title">
      <h2>Kit docente <span class="tag" data-kit-pro-badge>Pro</span></h2>
      <p>Estatuto, planificación y salidas.</p>
    </div>

    <div class="kit-locked is-hidden" data-kit-locked>
      <p class="muted">Disponible en plan Pro o durante la prueba.</p>
      <button type="button" class="btn btn-secondary" data-open-plan>Ver planes</button>
    </div>

    <div class="responsive-grid" data-kit-content>
      <article class="panel kit-card">
        <h3>Estatuto docente</h3>
        <p>Enlaces de normativa de uso frecuente.</p>
        <ul class="kit-links">
          <li><a href="https://normas.gba.gob.ar/" target="_blank" rel="noopener">Normativa PBA</a></li>
          <li><a href="https://abc.gob.ar/" target="_blank" rel="noopener">ABC / DGCyE</a></li>
        </ul>
        <input type="search" data-kit-estatuto-search placeholder="Buscar…" aria-label="Buscar en kit estatuto" />
        <ul class="kit-search-results" data-kit-estatuto-results>
          <li>Licencias ordinarias y extraordinarias</li>
          <li>Licencia por maternidad / adopción</li>
          <li>Licencia sin goce de haberes</li>
          <li>Artículo / resolución citada por dirección</li>
        </ul>
      </article>

      <article class="panel kit-card">
        <h3>Planificación</h3>
        <p>Plantilla base de unidad.</p>
        <button type="button" class="btn btn-secondary" data-download-planificacion>Descargar plantilla</button>
      </article>

      <article class="panel kit-card">
        <h3>Salidas educativas</h3>
        <p>Solicitud y recordatorio para el calendario.</p>
        <button type="button" class="btn btn-secondary" data-download-salida>Descargar solicitud</button>
        <button type="button" class="btn btn-ghost" data-spa-nav="actividades">Ir a Actividades</button>
      </article>

      <article class="panel kit-card" data-curriculum-card>
        <h3>Diseño curricular</h3>
        <p>Ayuda liviana por materia para recuperatorios.</p>
        <select data-curriculum-subject aria-label="Materia curricular"></select>
        <pre class="curriculum-preview" data-curriculum-preview>Elegí una materia.</pre>
        <button type="button" class="btn btn-primary" data-recovery-ai-goto data-spa-nav="actividades" data-activity-flow-open="contenido">Generar recuperación con IA</button>
      </article>
    </div>
  </section>
</section>

<section
  class="tools-hub-panel is-hidden"
  id="tools-hub-informes"
  role="tabpanel"
  aria-labelledby="tools-hub-tab-informes"
  data-tools-hub-panel="informes"
  data-tools-section="informes"
  hidden
>
  <section class="panel tools-section tools-placeholder" data-tools-informes-placeholder>
    <div class="section-title">
      <h2>Informes / Comunicados</h2>
      <p>Espacio preparado para reportes del curso y mensajes a familias.</p>
    </div>
    <div class="empty tools-placeholder-card">
      <h3>Próximamente</h3>
      <p>
        Acá vas a poder generar informes de asistencia y calificaciones,
        y armar comunicados para compartir con el equipo o las familias.
      </p>
      <p class="muted">Mientras tanto, usá Asistencia, Notas y el Panel para el seguimiento diario.</p>
      <div class="button-row">
        <button type="button" class="btn btn-secondary" data-spa-nav="asistencia">Ir a Asistencia</button>
        <button type="button" class="btn btn-secondary" data-spa-nav="notas">Ir a Notas</button>
        <button type="button" class="btn btn-ghost" data-spa-nav="panel">Volver al Panel</button>
      </div>
    </div>
  </section>
</section>
