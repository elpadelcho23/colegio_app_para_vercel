---
import AttendanceView from '../AttendanceView.astro';
import ActivityAiPanel from '../ActivityAiPanel.astro';
import GradesView from '../GradesView.astro';
import SchoolCyclePanel from '../SchoolCyclePanel.astro';
import ToolsView from '../ToolsView.astro';
import TrabajosEntregasPanel from '../TrabajosEntregasPanel.astro';
import UiIcon from '../UiIcon.astro';

interface Props {
  initialView?: string;
}

const { initialView = 'panel' } = Astro.props;
---

<div id="spa-root" data-spa-root data-initial-view={initialView}>
  <section class="spa-view page page-stack" data-spa-view="panel" data-spa-title="Panel docente">
    <section class="onboarding hero-card is-hidden" data-onboarding hidden aria-labelledby="onboarding-title">
      <div class="onboarding-header">
        <p class="eyebrow">Primeros pasos</p>
        <h2 id="onboarding-title">¿Arrancamos con el tutorial?</h2>
        <p class="onboarding-lead copy-collapse-mobile">
          Armá el aula: Excel o a mano, curso actual y pasar lista. Si salís, podés retomar.
        </p>
      </div>

      <div class="onboarding-actions">
        <button
          type="button"
          class="btn btn-primary btn-block onboarding-start-btn"
          data-setup-tutorial-start
        >
          <span class="onboarding-start-badge copy-collapse-mobile">Recomendado</span>
          <span class="copy-long">Sí, arrancamos el tutorial</span>
          <span class="copy-short">Arrancar tutorial</span>
        </button>
        <button type="button" class="btn btn-ghost btn-block" data-onboarding-dismiss>
          Ahora no
        </button>
      </div>
    </section>

    <div class="onboarding-progress is-hidden" data-onboarding-progress hidden>
      <p>
        <strong>Tutorial</strong>
        · <span data-onboarding-progress-count>1 de 4</span>
      </p>
      <button type="button" class="btn btn-primary btn-sm" data-setup-tutorial-continue>Continuar</button>
    </div>

    <button type="button" class="onboarding-resume btn btn-ghost is-hidden" data-onboarding-resume hidden>
      <span class="copy-long">Retomar tutorial</span>
      <span class="copy-short">Tutorial</span>
    </button>

    <section class="hero-card" data-panel-hero>
      <p class="eyebrow" data-panel-eyebrow>Hoy</p>
      <h1 data-panel-today-title>Elegí el curso para empezar</h1>
      <p class="hero-help copy-collapse-mobile" data-panel-setup-help>Elegí curso y materia arriba, o importá el listado.</p>
      <p class="hero-help copy-collapse-mobile is-hidden" data-panel-ready-help hidden>Asistencia, notas y actividades de este curso.</p>

      <div class="schedule-suggestion is-hidden" data-schedule-suggestion hidden>
        <p>
          Sugerencia:
          <strong data-schedule-suggestion-label></strong>
        </p>
        <button type="button" class="btn btn-secondary btn-sm" data-schedule-suggestion-apply>Usar ahora</button>
      </div>

      <div class="hero-actions hero-actions--work">
        <button type="button" class="btn btn-primary hero-cta" data-panel-pick-course data-gtc-open>
          Elegir curso
        </button>
        <button type="button" data-spa-nav="asistencia" class="btn btn-primary hero-cta is-hidden" data-panel-work-cta hidden>Asistencia</button>
        <button type="button" data-spa-nav="notas" class="btn btn-secondary hero-cta is-hidden" data-panel-work-cta hidden>Calificaciones</button>
        <button type="button" data-spa-nav="actividades" class="btn btn-secondary hero-cta is-hidden" data-panel-work-cta hidden>Actividades</button>
        <button type="button" class="btn btn-secondary hero-cta" data-panel-import-excel data-tools-focus="importar" data-tools-tab="alumnos">
          <span class="copy-long">Importar desde Excel</span>
          <span class="copy-short">Importar</span>
        </button>
      </div>
    </section>

    <section class="panel panel-day-summary is-hidden" data-panel-summary hidden>
      <div class="section-title">
        <h2>Resumen</h2>
      </div>
      <div class="metric-grid metric-grid--panel" data-dashboard></div>
      <div data-alerts></div>
    </section>

    <section class="panel is-hidden" data-seguimiento hidden>
      <div class="section-title">
        <h2>Seguimiento</h2>
        <p class="copy-collapse-mobile">Asistencia o trabajos pendientes.</p>
      </div>
      <div class="list" data-seguimiento-list></div>
    </section>

    <details class="panel panel-collapsible panel-collapsible--quiet" data-teacher-context>
      <summary class="panel-collapsible-summary">
        <span class="section-title">
          <h2>Horario (opcional)</h2>
          <p class="copy-collapse-mobile">Sugiere el curso del día.</p>
        </span>
      </summary>
      <form class="form-grid" data-context-form>
        <fieldset class="day-picker">
          <legend>Días</legend>
          <div class="days-checkboxes">
            <label><input type="checkbox" name="dias" value="1" /> Lun</label>
            <label><input type="checkbox" name="dias" value="2" /> Mar</label>
            <label><input type="checkbox" name="dias" value="3" /> Mié</label>
            <label><input type="checkbox" name="dias" value="4" /> Jue</label>
            <label><input type="checkbox" name="dias" value="5" /> Vie</label>
          </div>
          <small class="field-error" data-context-days-error hidden></small>
        </fieldset>

        <div class="input-group full-width">
          <label><span>Desde</span><input type="time" name="desde" required /></label>
          <label><span>Hasta</span><input type="time" name="hasta" required /></label>
        </div>

        <label><span>Escuela</span><select name="escuela" required></select></label>
        <label><span>Curso</span><select name="cursoId" required></select></label>
        <label><span>Materia</span><select name="materiaId" required></select></label>

        <button class="btn btn-primary" type="submit">Guardar bloque</button>
      </form>
      <div class="list" data-context-list></div>
    </details>
  </section>

  <section class="spa-view page page-stack spa-view--hidden" data-spa-view="registro" data-spa-title="Registro de alumnos" data-students>
    <header class="page-header">
      <div class="header-content">
        <p class="eyebrow">Alumnos</p>
        <h1>Alumnos</h1>
        <p class="copy-collapse-mobile">Planilla del curso. Tocá un nombre para ver el perfil. La importación masiva está en Herramientas.</p>
      </div>
      <div class="actions-group">
        <button type="button" class="btn btn-primary btn-block" data-tools-focus="importar" data-tools-tab="alumnos">
          Importar desde Excel
        </button>
        <button type="button" data-spa-nav="cursos" class="btn btn-secondary btn-block">
          <span class="copy-long">Organizar cursos</span>
          <span class="copy-short">Cursos</span>
        </button>
      </div>
    </header>

    <section class="panel student-workspace">
      <section class="panel">
        <div class="section-title">
          <h2>Planilla de alumnos</h2>
          <p data-student-list-caption>Elegí un curso arriba para ver la planilla de esa división.</p>
        </div>
        <div class="table-container" data-student-list></div>
      </section>

      <details class="panel panel-collapsible student-manual-details" data-student-mode-panel="manual">
        <summary class="panel-collapsible-summary">
          <span class="section-title">
            <h2>Cargar uno a uno</h2>
            <p class="copy-collapse-mobile">Formulario manual para altas puntuales.</p>
          </span>
        </summary>
        <form class="form-grid" data-student-form>
          <div class="input-group full-width">
            <label><span>Nombre completo</span><input name="nombre" autocomplete="name" required /><small class="field-error" hidden></small></label>
            <label><span>DNI opcional</span><input name="dni" inputmode="numeric" /></label>
          </div>

          <label class="full-width">
            <span>Escuela</span>
            <select name="escuela" data-student-school required></select>
            <small class="field-error" hidden></small>
          </label>

          <label class="full-width">
            <span>Curso</span>
            <select name="cursoId" required></select>
            <small class="field-error" hidden></small>
          </label>

          <fieldset class="subject-picker">
            <legend>Materias del alumno</legend>
            <div class="subject-search" data-student-subjects></div>
            <div class="inline-form">
              <input name="nuevaMateria" data-student-new-subject placeholder="Escribí el nombre de la materia..." aria-label="Nueva materia" />
              <button class="btn btn-secondary" type="button" data-student-add-subject>Agregar materia</button>
            </div>
          </fieldset>

          <label class="full-width">
            <span>Tutor o contacto</span>
            <input name="tutor" />
          </label>

          <button class="btn btn-primary btn-block" type="submit">Guardar alumno</button>
        </form>
      </details>
    </section>

    <dialog class="modal modal--wide" data-student-profile-dialog>
      <form class="panel form-grid" data-student-profile-form novalidate>
        <div class="section-title">
          <h2 data-student-profile-title>Perfil del alumno</h2>
          <p>Revisá y modificá los datos del alumno.</p>
        </div>

        <input type="hidden" name="studentId" />

        <div class="input-group full-width">
          <label>
            <span>Nombre completo</span>
            <input name="nombre" autocomplete="name" required />
            <small class="field-error" hidden></small>
          </label>
          <label>
            <span>DNI opcional</span>
            <input name="dni" inputmode="numeric" />
          </label>
        </div>

        <label class="full-width">
          <span>Escuela</span>
          <select name="escuela" data-student-profile-school required></select>
          <small class="field-error" hidden></small>
        </label>

        <label class="full-width">
          <span>Curso</span>
          <select name="cursoId" data-student-profile-curso required></select>
          <small class="field-error" hidden></small>
        </label>

        <fieldset class="subject-picker">
          <legend>Materias del alumno</legend>
          <div class="subject-search" data-student-profile-subjects></div>
          <div class="inline-form">
            <input name="nuevaMateria" data-student-profile-new-subject placeholder="Escribí el nombre de la materia..." aria-label="Nueva materia" />
            <button class="btn btn-secondary" type="button" data-student-profile-add-subject>Agregar materia</button>
          </div>
        </fieldset>

        <label class="full-width">
          <span>Tutor o contacto</span>
          <input name="tutor" />
        </label>

        <label class="full-width checkbox-row">
          <input type="checkbox" name="activo" value="1" checked />
          <span>Alumno activo</span>
        </label>

        <div class="button-row full-width">
          <button class="btn btn-primary" type="submit">Guardar cambios</button>
          <button class="btn btn-secondary" type="button" data-student-profile-close>Cerrar</button>
        </div>
      </form>
    </dialog>
  </section>

  <section class="spa-view page page-stack spa-view--hidden" data-spa-view="cursos" data-spa-title="Cursos" data-courses>
    <header class="page-header">
      <div class="header-content">
        <p class="eyebrow">Organización</p>
        <h1>Cursos y divisiones</h1>
        <p class="copy-collapse-mobile">Escuela, curso, materias y horarios del ciclo.</p>
      </div>
      <div class="actions-group">
        <button type="button" class="btn btn-primary btn-block" data-scroll-target="[data-course-form]">
          Nuevo curso
        </button>
        <button type="button" class="btn btn-secondary btn-block" data-scroll-target="[data-excel-import='cursos']">
          <span class="copy-long">Importar cursos</span>
          <span class="copy-short">Importar</span>
        </button>
      </div>
    </header>

    <section class="courses-workspace" data-course-workspace>
      <div class="section-title">
        <h2>Cursos del ciclo activo</h2>
        <p>Creá una división nueva o revisá las que ya existen en el ciclo activo.</p>
      </div>
    <section class="responsive-grid">
      <form class="panel form-grid" data-course-form>
        <div class="section-title">
          <h2>Nuevo curso</h2>
        </div>

        <fieldset class="subject-picker">
          <legend>Escuelas</legend>
          <div class="notes-list" data-school-list></div>
          <div class="inline-form">
            <input data-new-school placeholder="Nombre de la escuela..." aria-label="Nombre de la escuela" />
            <button class="btn btn-secondary" type="button" data-add-school>Añadir escuela</button>
          </div>
        </fieldset>

        <label class="full-width">
          <span>Escuela</span>
          <select name="escuela" data-course-school required>
            <option value="">Seleccionar escuela</option>
          </select>
          <small class="field-error" hidden></small>
        </label>

        <label class="full-width">
          <span>Curso</span>
          <input name="nombre" placeholder="Ej: 6to 1ra" required />
          <small class="field-error" hidden></small>
        </label>

        <label class="full-width">
          <span>Turno</span>
          <select name="turno" required>
            <option value="">Seleccionar turno</option>
            <option>Mañana</option>
            <option>Tarde</option>
            <option>Noche</option>
          </select>
          <small class="field-error" hidden></small>
        </label>

        <button class="btn btn-primary btn-block" type="submit">Crear curso</button>
      </form>

      <section class="panel">
        <div class="section-title">
          <h2>Cursos activos</h2>
          <p>Divisiones del ciclo lectivo seleccionado, con alumnos y materias vinculadas.</p>
        </div>
        <div class="list" data-course-list></div>
      </section>
    </section>
    </section>

    <SchoolCyclePanel />

    <section class="panel" data-subjects>
      <div class="section-title">
        <h2>Materias</h2>
        <p>Gestioná las materias del docente. Se usan en Curso actual, Notas y Asistencia.</p>
      </div>
      <form class="inline-form" data-subject-form>
        <input name="nombre" placeholder="Nueva materia" aria-label="Nueva materia" required />
        <button class="btn btn-secondary" type="submit">Crear materia</button>
      </form>
      <div class="list" data-subject-list></div>
    </section>

    <section class="panel import-panel" data-excel-import="cursos">
      <div class="section-title">
        <h2>Cargar cursos desde Excel</h2>
        <p>Importá divisiones masivamente. Descargá la plantilla para ver columnas y ejemplos.</p>
      </div>
      <ul class="import-requirements">
        <li>Formato <strong>.xlsx</strong>, hoja <strong>Cursos</strong> (máx. 5 MB / 5000 filas).</li>
        <li>Columnas: <strong>Escuela</strong>, <strong>Curso</strong>, <strong>Turno</strong> (Mañana, Tarde o Noche).</li>
        <li><strong>Ciclo lectivo</strong> es opcional; si falta, usa el año actual.</li>
      </ul>
      <div class="inline-form import-form">
        <input type="file" accept=".xlsx,.xls" data-import-file aria-label="Archivo Excel de cursos" />
        <a class="btn btn-ghost" href="/api/import/template?type=cursos" data-import-template>Descargar plantilla</a>
        <button class="btn btn-secondary" type="button" data-import-submit>Importar cursos</button>
      </div>
      <div class="import-result" data-import-result hidden></div>
    </section>
  </section>

  <section class="spa-view page page-stack spa-view--hidden" data-spa-view="asistencia" data-spa-title="Asistencia" data-attendance data-inherit-global-context>
    <AttendanceView spaMode />
  </section>

  <section class="spa-view page page-stack spa-view--hidden" data-spa-view="notas" data-spa-title="Calificaciones" data-grades data-inherit-global-context>
    <GradesView spaMode />
  </section>

  <section class="spa-view page page-stack spa-view--hidden" data-spa-view="actividades" data-spa-title="Actividades" data-activities data-calendar data-inherit-global-context>
<header class="page-header">
      <div class="header-content">
        <p class="eyebrow">Agenda docente</p>
        <h1>Actividades</h1>
        <p class="copy-collapse-mobile">Entregas y corrección del curso actual.</p>
      </div>
      <button type="button" data-spa-nav="notas" class="btn btn-secondary btn-block">Ir a calificaciones</button>
    </header>

    <div class="context-gate is-hidden" data-context-gate hidden>
      <p>Elegí <strong>curso</strong> y <strong>materia</strong> en Curso actual para continuar.</p>
      <button type="button" class="btn btn-primary btn-sm" data-gtc-open>Elegir curso</button>
    </div>

    <p class="activity-context-hint" data-activity-context-hint>Elegí curso y materia en “Curso actual” arriba.</p>

    <div class="activity-flow-tabs" role="tablist" aria-label="Flujo de actividades" data-activity-flow-tabs>
      <button type="button" class="activity-flow-tab is-active" role="tab" data-activity-flow-tab="contenido" aria-selected="true" aria-controls="activity-flow-contenido" id="activity-tab-contenido">
        <UiIcon name="crear" />
        Crear
      </button>
      <button type="button" class="activity-flow-tab" role="tab" data-activity-flow-tab="clase" aria-selected="false" aria-controls="activity-flow-clase" id="activity-tab-clase">
        <UiIcon name="clase" />
        Clase virtual
      </button>
      <button type="button" class="activity-flow-tab" role="tab" data-activity-flow-tab="entregas" aria-selected="false" aria-controls="activity-flow-entregas" id="activity-tab-entregas">
        <UiIcon name="recibir" />
        Recibir entregas
      </button>
      <button type="button" class="activity-flow-tab" role="tab" data-activity-flow-tab="corregir" aria-selected="false" aria-controls="activity-flow-corregir" id="activity-tab-corregir">
        <UiIcon name="corregir" />
        Corregir
      </button>
    </div>

    <section class="activity-flow-panel" id="activity-flow-contenido" role="tabpanel" aria-labelledby="activity-tab-contenido" data-activity-flow-panel="contenido">
      <section class="responsive-grid is-balanced">
        <section class="panel activity-workspace" data-activity-workspace>
          <div class="section-title">
            <h2>Crear actividad</h2>
            <p>Evaluación o TP a mano; IA más abajo.</p>
          </div>

          <form class="form-grid" data-activity-form novalidate>
            <div class="input-group full-width activity-local-context">
              <label><span>Escuela</span><select name="colegio"></select><small class="field-error" hidden></small></label>
              <label><span>Turno</span><select name="turno"></select><small class="field-error" hidden></small></label>
              <label><span>Curso</span><select name="cursoId"></select><small class="field-error" hidden></small></label>
              <label><span>Materia</span><select name="materiaId"></select><small class="field-error" hidden></small></label>
            </div>

            <label class="full-width">
              <span>Título</span>
              <input name="titulo" placeholder="Ej: Evaluación integradora" required />
              <small class="field-error" hidden></small>
            </label>

            <div class="input-group full-width">
              <label><span>Publicación</span><input type="date" name="fechaPublicacion" /></label>
              <label><span>Entrega</span><input type="date" name="fechaVencimiento" /></label>
            </div>

            <div class="activity-mode-panel full-width" data-activity-mode-panel="manual">
              <div class="activity-template-picker full-width" role="radiogroup" aria-label="Tipo de actividad">
                <label class="template-card"><input type="radio" name="tipo" value="evaluacion" checked /> <strong>Evaluación</strong></label>
                <label class="template-card"><input type="radio" name="tipo" value="tp" /> <strong>TP</strong></label>
              </div>

              <section class="activity-editor full-width" data-activity-editor></section>

              <div class="button-row full-width">
                <button class="btn btn-secondary" type="button" id="btn-descargar-word">Word</button>
                <button class="btn btn-secondary" type="button" id="btn-descargar-pdf">PDF</button>
                <button class="btn btn-primary" type="submit" data-activity-save-label>Guardar actividad</button>
              </div>
            </div>
          </form>
        </section>

        <section class="panel">
          <div class="section-title">
            <h2>Actividades preparadas</h2>
            <p>Del curso actual. Enviá un TP o examen a otro curso si hace falta.</p>
          </div>
          <label class="activity-list-scope">
            <input type="checkbox" data-activity-list-all />
            <span>Ver todas las actividades (otros cursos)</span>
          </label>
          <div class="list" data-activity-list></div>
        </section>
      </section>

      <ActivityAiPanel />
    </section>

    <section class="activity-flow-panel is-hidden" id="activity-flow-clase" role="tabpanel" aria-labelledby="activity-tab-clase" data-activity-flow-panel="clase" data-clase-virtual-root hidden>
      <section class="panel clase-virtual-workspace">
        <div class="section-title">
          <h2>Clase virtual</h2>
          <p>Los alumnos entran con un link, responden en el celular o la compu, y al cerrar se corrige sola.</p>
        </div>

        <ol class="clase-virtual-steps" data-clase-steps aria-label="Pasos de la clase virtual">
          <li>
            <button type="button" class="clase-step-btn is-current" data-clase-step="1">
              <span class="clase-step-icon"><UiIcon name="crear" /></span>
              <span class="clase-step-copy"><strong>Crear</strong><small>Tipo y tiempo</small></span>
            </button>
          </li>
          <li>
            <button type="button" class="clase-step-btn" data-clase-step="2">
              <span class="clase-step-icon"><UiIcon name="lista" /></span>
              <span class="clase-step-copy"><strong>Preguntas</strong><small>IA, hecha o a mano</small></span>
            </button>
          </li>
          <li>
            <button type="button" class="clase-step-btn" data-clase-step="3">
              <span class="clase-step-icon"><UiIcon name="enlace" /></span>
              <span class="clase-step-copy"><strong>Compartir</strong><small>Link al curso</small></span>
            </button>
          </li>
        </ol>

        <form class="form-grid" data-clase-form novalidate>
          <section data-clase-panel="1">
            <div class="clase-panel-heading">
              <UiIcon name="crear" />
              <div>
                <h3>Datos de la clase</h3>
                <p>Elegí el tipo. El curso ya está en el encabezado.</p>
              </div>
            </div>

            <div class="input-group full-width activity-local-context">
              <label><span>Escuela</span><select name="colegio" data-clase-colegio></select></label>
              <label><span>Turno</span><select name="turno" data-clase-turno></select></label>
              <label><span>Curso</span><select name="cursoId" data-clase-curso></select></label>
              <label><span>Materia</span><select name="materiaId" data-clase-materia></select></label>
            </div>

            <label class="full-width">
              <span>Título</span>
              <input name="titulo" placeholder="Ej: Prueba digital — funciones" required />
            </label>

            <div class="activity-template-picker full-width" role="radiogroup" aria-label="Tipo de clase digital">
              <label class="template-card clase-mode-card">
                <input type="radio" name="modo" value="multiple_choice" checked />
                <span>
                  <UiIcon name="lista" />
                  <strong>Opción múltiple</strong>
                  <small>Se corrige sola</small>
                </span>
              </label>
              <label class="template-card clase-mode-card">
                <input type="radio" name="modo" value="actividad_preguntas" />
                <span>
                  <UiIcon name="notas" />
                  <strong>Con abiertas</strong>
                  <small>MC + texto (IA)</small>
                </span>
              </label>
              <label class="template-card clase-mode-card">
                <input type="radio" name="modo" value="examen" />
                <span>
                  <UiIcon name="examen" />
                  <strong>Examen</strong>
                  <small>Timer y control</small>
                </span>
              </label>
            </div>

            <div class="clase-time-row full-width">
              <p class="clase-field-label"><UiIcon name="reloj" /> Tiempo</p>
              <div class="input-group">
                <label><span>Minutos para responder</span><input type="number" name="duracionMinutos" min="5" max="240" value="40" /></label>
                <label><span>El link vale (horas)</span><input type="number" name="expiresInHours" min="1" max="72" value="24" /></label>
              </div>
            </div>

            <label class="full-width aula-temp-check">
              <input type="checkbox" name="mostrarNota" checked />
              <span>Mostrar la nota al alumno cuando entrega</span>
            </label>

            <details class="clase-extra-details full-width">
              <summary>
                <UiIcon name="escudo" />
                <span>
                  <strong>Opciones de seguridad</strong>
                  <small>Opcional. En el celular no se puede bloquear Gemini al 100%: si sale, se ocultan las preguntas y cuenta como salida.</small>
                </span>
              </summary>
              <fieldset class="aula-temp-antitrampa">
                <legend class="sr-only">Disminuir trampas</legend>
                <label><input type="checkbox" name="atShuffleQuestions" checked /> Mezclar preguntas</label>
                <label><input type="checkbox" name="atShuffleOptions" checked /> Mezclar opciones</label>
                <label><input type="checkbox" name="atOneAtATime" /> Una pregunta a la vez</label>
                <label><input type="checkbox" name="atLockNav" /> Sin volver atrás</label>
                <label><input type="checkbox" name="atClipboard" checked /> Bloquear copiar/pegar</label>
                <label><input type="checkbox" name="atWatermark" checked /> Marca de agua con nombre</label>
                <label><input type="checkbox" name="atHideResults" /> Ocultar nota hasta cerrar</label>
                <label><span>Salidas de pestaña máx.</span><input type="number" name="atMaxFocus" min="0" max="20" value="3" /></label>
                <label>
                  <span>Si supera el límite</span>
                  <select name="atFocusAction">
                    <option value="flag">Solo alerta</option>
                    <option value="autosubmit">Entregar automático</option>
                    <option value="block">Bloquear</option>
                  </select>
                </label>
              </fieldset>
            </details>

            <div class="button-row full-width">
              <button type="button" class="btn btn-primary" data-clase-crear>
                <UiIcon name="crear" /> Crear y cargar preguntas
              </button>
            </div>
          </section>

          <section data-clase-panel="2" hidden>
            <div class="clase-panel-heading">
              <UiIcon name="lista" />
              <div>
                <h3>Cargar preguntas</h3>
                <p>Elegí una forma. Después se publica el link.</p>
              </div>
            </div>

            <div class="clase-method-tabs" role="tablist" aria-label="Cómo cargar las preguntas">
              <button type="button" class="clase-method-tab is-active" data-clase-method="existente">
                <UiIcon name="carpeta" /> Ya hecha
              </button>
              <button type="button" class="clase-method-tab" data-clase-method="ia">
                <UiIcon name="ia" /> Con IA
              </button>
              <button type="button" class="clase-method-tab" data-clase-method="manual">
                <UiIcon name="corregir" /> A mano
              </button>
            </div>

            <div data-clase-method-panel="existente" class="clase-method-panel">
              <p class="muted">Usá una actividad que ya creaste en la pestaña Crear.</p>
              <div class="clase-load-existing">
                <label>
                  <span>Actividad guardada</span>
                  <select data-clase-actividad-existente>
                    <option value="">Elegí una actividad</option>
                  </select>
                </label>
                <button type="button" class="btn btn-primary" data-clase-cargar-existente>
                  <UiIcon name="carpeta" /> Usar esta actividad
                </button>
              </div>
            </div>

            <div data-clase-method-panel="ia" class="clase-method-panel" hidden>
              <p class="muted">Pedile el formato y, si querés, adjuntá un documento o una actividad de referencia.</p>
              <div class="clase-ai-panel">
                <label>
                  <span>Actividad de referencia (opcional)</span>
                  <select data-clase-ai-ref>
                    <option value="">Ninguna</option>
                  </select>
                </label>
                <label>
                  <span>Documento (PDF, DOCX o TXT)</span>
                  <input type="file" data-clase-ai-files accept=".pdf,.docx,.txt,application/pdf" multiple />
                </label>
                <label>
                  <span>Qué tiene que armar</span>
                  <textarea data-clase-ai-prompt rows="3" placeholder="Ej: 10 multiple choice sobre funciones, 3º año, con clave"></textarea>
                </label>
                <div class="button-row">
                  <button type="button" class="btn btn-primary" data-clase-ai-generar>
                    <UiIcon name="ia" /> Generar preguntas
                  </button>
                </div>
                <p class="muted" data-clase-ai-status hidden></p>
              </div>
            </div>

            <div data-clase-method-panel="manual" class="clase-method-panel" hidden>
              <p class="muted">Armá o revisá las preguntas acá. Las respuestas son todas digitales.</p>
              <div data-clase-questions-editor></div>
            </div>

            <div class="button-row full-width">
              <button type="button" class="btn btn-secondary" data-clase-back-1>Volver</button>
              <button type="button" class="btn btn-primary" data-clase-guardar-actividad hidden>
                <UiIcon name="enlace" /> Guardar y obtener link
              </button>
            </div>
          </section>

          <section data-clase-panel="3" hidden>
            <div class="clase-panel-heading">
              <UiIcon name="enlace" />
              <div>
                <h3>Compartir con el curso</h3>
                <p>Mandá el link. Al cerrar, se corrige y se cargan las notas.</p>
              </div>
            </div>

            <div class="aula-temp-link-box">
              <p class="clase-field-label"><UiIcon name="enlace" /> Link de la clase</p>
              <p class="aula-temp-link-url" data-clase-url></p>
              <div class="clase-share-actions">
                <div class="clase-action-group">
                  <p class="clase-action-label">Para el curso</p>
                  <div class="button-row">
                    <button type="button" class="btn btn-primary btn-sm" data-clase-copy>
                      <UiIcon name="copiar" /> Copiar link
                    </button>
                    <a class="btn btn-secondary btn-sm" data-clase-open target="_blank" rel="noopener">
                      <UiIcon name="externo" /> Abrir
                    </a>
                  </div>
                </div>
                <div class="clase-action-group">
                  <p class="clase-action-label">Durante la clase</p>
                  <div class="button-row">
                    <button type="button" class="btn btn-secondary btn-sm" data-clase-refresh>
                      <UiIcon name="alumnos" /> Ver intentos
                    </button>
                    <button type="button" class="btn btn-secondary btn-sm" data-clase-doc>
                      <UiIcon name="documento" /> Documento
                    </button>
                  </div>
                </div>
                <div class="clase-action-group">
                  <p class="clase-action-label">Cuando termina</p>
                  <div class="button-row">
                    <button type="button" class="btn btn-primary btn-sm" data-clase-close>
                      <UiIcon name="asistencia" /> Cerrar y corregir
                    </button>
                    <button type="button" class="btn btn-secondary btn-sm" data-clase-nueva>
                      <UiIcon name="crear" /> Nueva clase
                    </button>
                  </div>
                </div>
              </div>
            </div>
            <div class="list" data-clase-intentos></div>
          </section>
        </form>
      </section>
    </section>

    <section class="activity-flow-panel is-hidden" id="activity-flow-entregas" role="tabpanel" aria-labelledby="activity-tab-entregas" data-activity-flow-panel="entregas" data-entregas-root hidden>
      <TrabajosEntregasPanel mode="entregas" />
    </section>

    <section class="activity-flow-panel is-hidden" id="activity-flow-corregir" role="tabpanel" aria-labelledby="activity-tab-corregir" data-activity-flow-panel="corregir" data-corregir-root hidden>
      <TrabajosEntregasPanel mode="corregir" />
    </section>

    <details class="calendar-wrapper calendar-details" data-calendar-details>
      <summary class="calendar-details-summary">Calendario (opcional)</summary>
      <div class="panel calendar-panel">
        <div class="section-title">
          <h2>Calendario</h2>
          <p>Eventos del curso actual. Podés filtrar abajo si hace falta.</p>
        </div>
        <div class="filters">
          <input type="month" data-calendar-month aria-label="Mes" />
          <select data-calendar-course aria-label="Curso"></select>
          <select data-calendar-subject aria-label="Materia"></select>
        </div>
      </div>

      <div class="calendar-layout">
        <div class="calendar-scroll">
          <div class="calendar-grid" data-calendar-grid></div>
        </div>
        <div class="calendar-mobile-list" data-calendar-mobile-list aria-label="Eventos del mes"></div>
        <aside class="panel calendar-day-panel">
          <h2 data-calendar-selected-title>Seleccioná un día</h2>
          <p class="calendar-summary" data-calendar-selected-summary></p>
          <div class="list" data-calendar-day-events></div>
        </aside>
      </div>
    </details>

    <dialog class="modal" data-activity-enviar-dialog>
      <form class="panel form-grid" data-activity-enviar-form novalidate>
        <div class="section-title">
          <h2>Enviar actividad a un curso</h2>
          <p id="activity-enviar-source-label">Duplicá el material a otro curso, turno o materia.</p>
        </div>

        <input type="hidden" name="actividadId" />

        <div class="input-group full-width">
          <label><span>Escuela</span><select name="colegio" data-enviar-colegio required></select></label>
          <label><span>Turno</span><select name="turno" data-enviar-turno required></select></label>
        </div>

        <label class="full-width">
          <span>Curso destino</span>
          <select name="cursoId" data-enviar-curso required></select>
        </label>

        <label class="full-width">
          <span>Materia destino</span>
          <select name="materiaId" data-enviar-materia required></select>
        </label>

        <label class="full-width">
          <span>Título</span>
          <input name="titulo" placeholder="Se copia el título original si lo dejás igual" />
        </label>

        <div class="input-row full-width">
          <label><span>Publicación</span><input type="date" name="fechaPublicacion" /></label>
          <label><span>Entrega</span><input type="date" name="fechaVencimiento" /></label>
        </div>

        <div class="button-row full-width">
          <button class="btn btn-primary" type="submit" value="confirm">Enviar al curso</button>
          <button class="btn btn-secondary" type="button" data-enviar-cancel>Cancelar</button>
        </div>
      </form>
    </dialog>

    <dialog class="modal" data-calendar-opt-in>
      <form method="dialog" class="panel">
        <h2>Recordatorios</h2>
        <label>
          <span>Días de anticipación</span>
          <input type="number" min="1" max="30" value="3" data-calendar-lead-days />
        </label>
        <div class="button-row">
          <button class="btn btn-primary" value="accept" data-calendar-alerts-accept>Activar</button>
          <button class="btn btn-secondary" value="dismiss" data-calendar-alerts-dismiss>Ahora no</button>
        </div>
      </form>
    </dialog>
  </section>

  <section class="spa-view page page-stack spa-view--hidden" data-spa-view="herramientas" data-spa-title="Herramientas" data-herramientas>
    <ToolsView />
  </section>
</div>
