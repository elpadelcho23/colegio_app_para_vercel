---
import AttendanceView from '../AttendanceView.astro';
import ExcelImportWorkspace from '../ExcelImportWorkspace.astro';
import GradesView from '../GradesView.astro';
import SchoolCyclePanel from '../SchoolCyclePanel.astro';
import ToolsView from '../ToolsView.astro';

interface Props {
  initialView?: string;
}

const { initialView = 'panel' } = Astro.props;
---

<div id="spa-root" data-spa-root data-initial-view={initialView}>
  <section class="spa-view page page-stack" data-spa-view="panel" data-spa-title="Panel docente">
    <section class="onboarding hero-card is-hidden" data-onboarding hidden aria-labelledby="onboarding-title">
      <div class="onboarding-header">
        <p class="eyebrow">Primeros pasos</p>
        <h2 id="onboarding-title">Configurá tu aula</h2>
        <p class="onboarding-progress" data-onboarding-progress aria-live="polite">Paso 1 de 3</p>
      </div>

      <ol class="onboarding-steps" data-onboarding-steps aria-label="Pasos de configuración inicial"></ol>

      <div class="onboarding-actions">
        <button type="button" class="btn btn-primary btn-block" data-onboarding-cta data-spa-nav="cursos">
          Crear curso
        </button>
        <button type="button" class="btn btn-ghost btn-block" data-onboarding-dismiss>
          Omitir por ahora
        </button>
      </div>
    </section>

    <button type="button" class="onboarding-resume btn btn-ghost is-hidden" data-onboarding-resume hidden>
      Completar configuración
    </button>

    <section class="hero-card" data-panel-hero>
      <p class="eyebrow">Hoy</p>
      <h1>Panel del día</h1>

      <div class="context-banner" data-context-banner>
        <strong>Contexto sugerido</strong>
        <p data-context-summary>Configurá tu horario para sugerencias.</p>
      </div>

      <div class="hero-actions">
        <button type="button" data-spa-nav="asistencia" class="btn btn-primary btn-block" >Tomar asistencia</button>
        <button type="button" data-spa-nav="notas" class="btn btn-secondary btn-block" >Cargar calificaciones</button>
        <button type="button" data-spa-nav="actividades" class="btn btn-secondary btn-block" >Ver actividades</button>
      </div>
    </section>

    <section class="panel">
      <div class="section-title">
        <h2>Resumen del día</h2>
        <p>Filtros rápidos para ver asistencia, cursos y alertas del contexto actual.</p>
      </div>
      <div class="filters-grid" data-dashboard-filters>
        <select name="escuela" aria-label="Escuela"></select>
        <select name="curso" aria-label="Curso"></select>
        <select name="materia" aria-label="Materia"></select>
      </div>
      <div class="metric-grid" data-dashboard></div>
      <div data-alerts></div>
    </section>

    <section class="panel" data-teacher-context>
      <div class="section-title">
        <h2>Mi horario</h2>
        <p>Bloques habituales para sugerir curso y materia al iniciar cada tarea.</p>
      </div>
      <form class="form-grid" data-context-form>
        <fieldset class="day-picker">
          <legend>Días</legend>
          <div class="days-checkboxes">
            <label><input type="checkbox" name="dias" value="1" /> Lun</label>
            <label><input type="checkbox" name="dias" value="2" /> Mar</label>
            <label><input type="checkbox" name="dias" value="3" /> Mié</label>
            <label><input type="checkbox" name="dias" value="4" /> Jue</label>
            <label><input type="checkbox" name="dias" value="5" /> Vie</label>
          </div>
        </fieldset>

        <div class="input-group full-width">
          <label><span>Desde</span><input type="time" name="desde" required /></label>
          <label><span>Hasta</span><input type="time" name="hasta" required /></label>
        </div>

        <label><span>Escuela</span><select name="escuela" required></select></label>
        <label><span>Curso</span><select name="cursoId" required></select></label>
        <label><span>Materia</span><select name="materiaId" required></select></label>

        <button class="btn btn-primary" type="submit">Guardar bloque</button>
      </form>
      <div class="list" data-context-list></div>
    </section>
  </section>

  <section class="spa-view page page-stack spa-view--hidden" data-spa-view="registro" data-spa-title="Registro de alumnos" data-students>
    <header class="page-header">
      <div class="header-content">
        <p class="eyebrow">Alumnos</p>
        <h1>Registro simple</h1>
        <p>Cargá alumnos uno a uno con curso y materias.</p>
      </div>
      <button type="button" data-spa-nav="cursos" class="btn btn-secondary btn-block">Organizar cursos</button>
    </header>

    <section class="panel student-workspace">
      <div class="section-title">
        <h2>Registrar alumnos</h2>
        <p>Cargá alumnos uno a uno o importá desde Excel con una plantilla personalizada.</p>
      </div>

      <div class="activity-mode-picker full-width" role="tablist" aria-label="Modo de registro">
        <label class="template-card activity-mode-card">
          <input type="radio" name="studentMode" value="manual" checked data-student-mode-input />
          <span>
            <strong>Cargar uno a uno</strong>
            <small>Completá nombre, escuela, curso, materias y contacto.</small>
          </span>
        </label>
        <label class="template-card activity-mode-card">
          <input type="radio" name="studentMode" value="excel" data-student-mode-input />
          <span>
            <strong>Cargar desde hoja Excel</strong>
            <small>Mapeá columnas y guardá plantillas reutilizables.</small>
          </span>
        </label>
      </div>

      <section class="responsive-grid">
        <div class="student-mode-panel full-width" data-student-mode-panel="manual">
          <form class="panel form-grid" data-student-form>
            <div class="section-title">
              <h2>Nuevo alumno</h2>
            </div>

            <div class="input-group full-width">
              <label><span>Nombre completo</span><input name="nombre" autocomplete="name" required /></label>
              <label><span>DNI opcional</span><input name="dni" inputmode="numeric" /></label>
            </div>

            <label class="full-width">
              <span>Escuela</span>
              <select name="escuela" data-student-school required></select>
            </label>

            <label class="full-width">
              <span>Curso</span>
              <select name="cursoId" required></select>
            </label>

            <fieldset class="subject-picker">
              <legend>Materias del alumno</legend>
              <div class="subject-search" data-student-subjects></div>
              <div class="inline-form">
                <input name="nuevaMateria" data-student-new-subject placeholder="Escribí el nombre de la materia..." aria-label="Nueva materia" />
                <button class="btn btn-secondary" type="button" data-student-add-subject>Agregar materia</button>
              </div>
            </fieldset>

            <label class="full-width">
              <span>Tutor o contacto</span>
              <input name="tutor" />
            </label>

            <button class="btn btn-primary btn-block" type="submit">Guardar alumno</button>
          </form>
        </div>

        <div class="student-mode-panel full-width is-hidden" data-student-mode-panel="excel">
          <ExcelImportWorkspace importType="alumnos" />
        </div>

        <section class="panel">
          <div class="section-title">
            <h2>Alumnos cargados</h2>
            <p>Listado con curso, materias y promedio actualizado.</p>
          </div>
          <div class="list" data-student-list></div>
        </section>
      </section>

      <p class="tools-nav-link-wrap">
        <button type="button" class="tools-nav-link" data-tools-focus="excel" data-tools-tab="alumnos">
          ¿Muchos alumnos? Importá desde Excel en Más herramientas →
        </button>
      </p>
    </section>
  </section>

  <section class="spa-view page page-stack spa-view--hidden" data-spa-view="cursos" data-spa-title="Cursos" data-courses>
    <header class="page-header">
      <div class="header-content">
        <p class="eyebrow">Organización</p>
        <h1>Cursos y divisiones</h1>
        <p>Base de trabajo por ciclo lectivo: escuela, curso, materias y horarios.</p>
      </div>
      <button type="button" data-spa-nav="registro" class="btn btn-secondary btn-block" >Cargar alumnos</button>
    </header>

    <SchoolCyclePanel />

    <section class="responsive-grid">
      <form class="panel form-grid" data-course-form>
        <div class="section-title">
          <h2>Nuevo curso</h2>
        </div>

        <fieldset class="subject-picker">
          <legend>Escuelas</legend>
          <div class="notes-list" data-school-list></div>
          <div class="inline-form">
            <input data-new-school placeholder="Nombre de la escuela..." aria-label="Nombre de la escuela" />
            <button class="btn btn-secondary" type="button" data-add-school>Añadir escuela</button>
          </div>
        </fieldset>

        <label class="full-width">
          <span>Escuela</span>
          <select name="escuela" data-course-school required>
            <option value="">Seleccionar escuela</option>
          </select>
        </label>

        <label class="full-width">
          <span>Curso</span>
          <input name="nombre" placeholder="Ej: 6to 1ra" required />
        </label>

        <label class="full-width">
          <span>Turno</span>
          <select name="turno" required>
            <option value="">Seleccionar turno</option>
            <option>Mañana</option>
            <option>Tarde</option>
            <option>Noche</option>
          </select>
        </label>

        <button class="btn btn-primary btn-block" type="submit">Crear curso</button>
      </form>

      <section class="panel">
        <div class="section-title">
          <h2>Cursos activos</h2>
          <p>Divisiones del ciclo lectivo seleccionado, con alumnos y materias vinculadas.</p>
        </div>
        <div class="list" data-course-list></div>
      </section>
    </section>

    <section class="panel import-panel" data-excel-import="cursos">
      <div class="section-title">
        <h2>Cargar cursos desde Excel</h2>
        <p>Importá divisiones masivamente. Descargá la plantilla para ver columnas y ejemplos.</p>
      </div>
      <ul class="import-requirements">
        <li>Formato <strong>.xlsx</strong>, hoja <strong>Cursos</strong> (máx. 5 MB / 5000 filas).</li>
        <li>Columnas: <strong>Escuela</strong>, <strong>Curso</strong>, <strong>Turno</strong> (Mañana, Tarde o Noche).</li>
        <li><strong>Ciclo lectivo</strong> es opcional; si falta, usa el año actual.</li>
      </ul>
      <div class="inline-form import-form">
        <input type="file" accept=".xlsx,.xls" data-import-file aria-label="Archivo Excel de cursos" />
        <a class="btn btn-ghost" href="/api/import/template?type=cursos" data-import-template>Descargar plantilla</a>
        <button class="btn btn-secondary" type="button" data-import-submit>Importar cursos</button>
      </div>
      <div class="import-result" data-import-result hidden></div>
    </section>
  </section>

  <section class="spa-view page page-stack spa-view--hidden" data-spa-view="asistencia" data-spa-title="Asistencia" data-attendance>
    <AttendanceView spaMode />
  </section>

  <section class="spa-view page page-stack spa-view--hidden" data-spa-view="notas" data-spa-title="Calificaciones" data-grades>
    <GradesView spaMode />
  </section>

  <section class="spa-view page page-stack spa-view--hidden" data-spa-view="actividades" data-spa-title="Actividades" data-activities data-calendar>
<header class="page-header">
      <div class="header-content">
        <p class="eyebrow">Agenda docente</p>
        <h1>Actividades y calendario</h1>
        <p>Avisos de evaluación, TP y fechas importantes en una sola pantalla.</p>
      </div>
      <button type="button" data-spa-nav="notas" class="btn btn-secondary btn-block" >Ir a calificaciones</button>
    </header>

    <section class="responsive-grid is-balanced">
      <section class="panel activity-workspace" data-activity-workspace>
        <div class="section-title">
          <h2>Realizar actividades</h2>
          <p>Creá evaluaciones y TP. Completá colegio, curso y materia antes de guardar o generar con IA.</p>
        </div>

        <form class="form-grid" data-activity-form>
          <div class="input-group full-width">
            <label><span>Colegio</span><select name="colegio" required></select></label>
            <label><span>Turno</span><select name="turno" required></select></label>
            <label><span>Curso</span><select name="cursoId" required></select></label>
            <label><span>Materia</span><select name="materiaId" required></select></label>
          </div>

          <label class="full-width">
            <span>Título</span>
            <input name="titulo" placeholder="Ej: Evaluación integradora" required />
          </label>

          <div class="input-group full-width">
            <label><span>Publicación</span><input type="date" name="fechaPublicacion" /></label>
            <label><span>Entrega</span><input type="date" name="fechaVencimiento" /></label>
          </div>

          <div class="activity-mode-panel full-width" data-activity-mode-panel="manual">
            <div class="activity-template-picker full-width" role="radiogroup">
              <label class="template-card"><input type="radio" name="tipo" value="evaluacion" checked /> <strong>Evaluación</strong></label>
              <label class="template-card"><input type="radio" name="tipo" value="tp" /> <strong>TP</strong></label>
            </div>

            <section class="activity-editor full-width" data-activity-editor></section>

            <div class="button-row full-width">
              <button class="btn btn-secondary" type="button" id="btn-descargar-word">Word</button>
              <button class="btn btn-secondary" type="button" id="btn-descargar-pdf">PDF</button>
              <button class="btn btn-primary" type="submit">Guardar actividad</button>
            </div>
          </div>
        </form>

        <p class="tools-nav-link-wrap">
          <button type="button" class="tools-nav-link" data-tools-focus="ai">
            Generar con IA → Más herramientas
          </button>
          <button type="button" class="tools-nav-link" data-tools-focus="entregas">
            Gestionar entregas de alumnos → Más herramientas
          </button>
        </p>
      </section>

      <section class="panel">
        <div class="section-title">
          <h2>Actividades preparadas</h2>
          <p>Enviá un TP, examen o actividad ya cargada a otro curso o turno.</p>
        </div>
        <div class="list" data-activity-list></div>
      </section>
    </section>

    <section class="calendar-wrapper">
      <div class="panel calendar-panel">
        <div class="section-title">
          <h2>Calendario</h2>
        </div>
        <div class="filters">
          <input type="month" data-calendar-month aria-label="Mes" />
          <select data-calendar-course aria-label="Curso"></select>
          <select data-calendar-subject aria-label="Materia"></select>
        </div>
      </div>

      <div class="calendar-layout">
        <div class="calendar-scroll">
          <div class="calendar-grid" data-calendar-grid></div>
        </div>
        <div class="calendar-mobile-list" data-calendar-mobile-list aria-label="Eventos del mes"></div>
        <aside class="panel calendar-day-panel">
          <h2 data-calendar-selected-title>Seleccioná un día</h2>
          <p class="calendar-summary" data-calendar-selected-summary></p>
          <div class="list" data-calendar-day-events></div>
        </aside>
      </div>
    </section>

    <dialog class="modal" data-activity-enviar-dialog>
      <form method="dialog" class="panel form-grid" data-activity-enviar-form>
        <div class="section-title">
          <h2>Enviar actividad a un curso</h2>
          <p id="activity-enviar-source-label">Duplicá el material a otro curso, turno o materia.</p>
        </div>

        <input type="hidden" name="actividadId" />

        <div class="input-group full-width">
          <label><span>Colegio</span><select name="colegio" data-enviar-colegio required></select></label>
          <label><span>Turno</span><select name="turno" data-enviar-turno required></select></label>
        </div>

        <label class="full-width">
          <span>Curso destino</span>
          <select name="cursoId" data-enviar-curso required></select>
        </label>

        <label class="full-width">
          <span>Materia destino</span>
          <select name="materiaId" data-enviar-materia required></select>
        </label>

        <label class="full-width">
          <span>Título</span>
          <input name="titulo" placeholder="Se copia el título original si lo dejás igual" />
        </label>

        <div class="input-row full-width">
          <label><span>Publicación</span><input type="date" name="fechaPublicacion" /></label>
          <label><span>Entrega</span><input type="date" name="fechaVencimiento" /></label>
        </div>

        <div class="button-row full-width">
          <button class="btn btn-primary" type="submit" value="confirm">Enviar al curso</button>
          <button class="btn btn-secondary" type="submit" value="cancel">Cancelar</button>
        </div>
      </form>
    </dialog>

    <dialog class="modal" data-calendar-opt-in>
      <form method="dialog" class="panel">
        <h2>Recordatorios</h2>
        <label>
          <span>Días de anticipación</span>
          <input type="number" min="1" max="30" value="3" data-calendar-lead-days />
        </label>
        <div class="button-row">
          <button class="btn btn-primary" value="accept" data-calendar-alerts-accept>Activar</button>
          <button class="btn btn-secondary" value="dismiss" data-calendar-alerts-dismiss>Ahora no</button>
        </div>
      </form>
    </dialog>
  </section>

  <section class="spa-view page page-stack spa-view--hidden" data-spa-view="herramientas" data-spa-title="Más herramientas" data-herramientas>
    <ToolsView />
  </section>
</div>
