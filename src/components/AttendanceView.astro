---
import ExcelImportWorkspace from './ExcelImportWorkspace.astro';

interface Props {
  spaMode?: boolean;
}

const { spaMode = false } = Astro.props;
---

<header class="page-header">
  <div class="header-content">
    <p class="eyebrow">Control diario</p>
    <h1>Asistencia</h1>
    <p class="copy-collapse-mobile">Pasá lista e historial del curso actual.</p>
  </div>
  <div class="actions-group">
    {spaMode ? (
      <button type="button" data-spa-nav="notas" class="btn btn-ghost btn-block">Ir a notas</button>
    ) : (
      <a class="btn btn-ghost btn-block" href="/notas">Ir a notas</a>
    )}
  </div>
</header>

<div class="context-gate is-hidden" data-context-gate hidden>
  <p>Elegí <strong>curso</strong> y <strong>materia</strong> en Curso actual para pasar lista.</p>
  <button type="button" class="btn btn-primary btn-sm" data-gtc-open>Elegir curso</button>
</div>

<section class="panel" data-attendance-take-view>
  <div class="section-title">
    <h2>Pasar lista</h2>
    <p>En listado o de a uno. Después Guardar.</p>
  </div>

  <div class="filters-grid">
    <input type="date" data-attendance-date aria-label="Fecha" />
    <select data-filter-course aria-label="Curso (curso actual)"></select>
    <div class="filter-field">
      <select data-filter-subject aria-label="Materia (curso actual)"></select>
      <small class="field-error" data-attendance-subject-error hidden></small>
    </div>
  </div>
  <p class="muted filter-context-note copy-collapse-mobile">Sigue el Curso actual.</p>

  <div class="attendance-mode-tabs" role="tablist" aria-label="Modo de pasar lista" data-attendance-mode-tabs>
    <button type="button" class="history-tab is-active" role="tab" data-attendance-mode="list" aria-selected="true">Listado</button>
    <button type="button" class="history-tab" role="tab" data-attendance-mode="roll" aria-selected="false">Dar lista</button>
  </div>

  <section class="summary-strip" data-attendance-summary></section>

  <div class="list" data-attendance-list></div>
  <div class="roll-call" data-attendance-roll hidden></div>

  <div class="attendance-save-bar" data-attendance-save-bar>
    <p class="attendance-save-hint" data-attendance-save-hint>
      <span class="copy-long">Tenés cambios sin guardar. Revisá el listado y confirmá cuando termines.</span>
      <span class="copy-short">Cambios sin guardar.</span>
    </p>
    <button class="btn btn-primary" type="button" data-attendance-save disabled>
      Guardar asistencias
    </button>
  </div>
</section>

<section class="panel history-panel" data-attendance-history-view>
  <div class="section-title">
    <h2>Historial</h2>
    <p class="copy-collapse-mobile">Filtrá y mirá el día, los promedios o la planilla del mes.</p>
  </div>

  <div class="filters-grid history-filters">
    <select data-history-filter-school aria-label="Escuela">
      <option value="">Todas las escuelas</option>
    </select>
    <select data-history-filter-course aria-label="Curso">
      <option value="">Todos los cursos</option>
    </select>
    <select data-history-filter-subject aria-label="Materia">
      <option value="">Todas las materias</option>
    </select>
    <div class="history-date-range">
      <input type="date" data-history-filter-from aria-label="Desde" />
      <input type="date" data-history-filter-to aria-label="Hasta" />
    </div>
  </div>

  <p class="history-kpis" data-attendance-history-summary></p>

  <div class="history-tabs" role="tablist" aria-label="Vistas del historial" data-history-tabs>
    <button type="button" class="history-tab is-active" role="tab" data-history-tab="dia" aria-selected="true" aria-controls="history-panel-dia" id="history-tab-dia">Día</button>
    <button type="button" class="history-tab" role="tab" data-history-tab="promedios" aria-selected="false" aria-controls="history-panel-promedios" id="history-tab-promedios">Promedios</button>
    <button type="button" class="history-tab" role="tab" data-history-tab="planilla" aria-selected="false" aria-controls="history-panel-planilla" id="history-tab-planilla">Planilla</button>
  </div>

  <div class="history-tab-panel" id="history-panel-dia" role="tabpanel" aria-labelledby="history-tab-dia" data-history-panel="dia">
    <div class="table-container" data-attendance-history-table></div>
  </div>

  <div class="history-tab-panel" id="history-panel-promedios" role="tabpanel" aria-labelledby="history-tab-promedios" data-history-panel="promedios" hidden>
    <div class="table-container" data-attendance-history-averages></div>
  </div>

  <div class="history-tab-panel" id="history-panel-planilla" role="tabpanel" aria-labelledby="history-tab-planilla" data-history-panel="planilla" hidden>
    <div class="filters-grid history-matrix-filters" data-attendance-matrix-filters>
      <input type="month" data-attendance-matrix-month aria-label="Mes" />
      <label class="threshold-field">
        <span>Umbral %</span>
        <input type="number" min="50" max="100" step="1" data-attendance-threshold aria-label="Umbral de asistencia" />
      </label>
      <button type="button" class="btn btn-secondary" data-attendance-matrix-export>
        <span class="copy-long">Exportar CSV</span>
        <span class="copy-short">CSV</span>
      </button>
    </div>
    <p class="muted attendance-matrix-scroll-hint" aria-hidden="true">Deslizá para ver los días →</p>
    <div class="table-container attendance-matrix-wrap" data-attendance-matrix></div>
  </div>
</section>

<p class="tools-nav-link-wrap">
  {spaMode ? (
    <button type="button" class="tools-nav-link" data-tools-focus="importar" data-tools-tab="asistencias">
      <span class="copy-long">¿Tenés planilla Excel? Importá o exportá en Herramientas</span>
      <span class="copy-short">Importar / exportar Excel</span>
    </button>
  ) : (
    <a class="tools-nav-link" href="/herramientas?tab=importar&tipo=asistencias">
      <span class="copy-long">¿Tenés planilla Excel? Importá o exportá en Herramientas</span>
      <span class="copy-short">Importar / exportar Excel</span>
    </a>
  )}
</p>
