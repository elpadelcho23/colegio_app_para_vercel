---
import ExcelImportWorkspace from './ExcelImportWorkspace.astro';

interface Props {
  spaMode?: boolean;
}

const { spaMode = false } = Astro.props;
---

<header class="page-header">
  <div class="header-content">
    <p class="eyebrow">Control diario</p>
    <h1>Toma de asistencia</h1>
    <p>Pasá lista del curso elegido arriba.</p>
  </div>
  <div class="actions-group">
    <button class="btn btn-secondary btn-block" type="button" data-attendance-view-toggle>Ver asistencias</button>
    {spaMode ? (
      <button type="button" data-spa-nav="notas" class="btn btn-ghost btn-block">Ver notas</button>
    ) : (
      <a class="btn btn-ghost btn-block" href="/notas">Ver notas</a>
    )}
  </div>
</header>

<section class="panel" data-attendance-take-view>
  <div class="filters-grid">
    <input type="date" data-attendance-date aria-label="Fecha" />
    <select data-filter-course aria-label="Curso"></select>
    <div class="filter-field">
      <select data-filter-subject aria-label="Materia"></select>
      <small class="field-error" data-attendance-subject-error hidden></small>
    </div>
  </div>

  <section class="summary-strip" data-attendance-summary></section>

  <div class="section-title">
    <h2>Alumnos</h2>
    <p>Presente o ausente, y después Guardar.</p>
  </div>
  <div class="list" data-attendance-list></div>

  <div class="attendance-save-bar" data-attendance-save-bar>
    <p class="attendance-save-hint" data-attendance-save-hint>
      Tenés cambios sin guardar. Revisá el listado y confirmá cuando termines.
    </p>
    <button class="btn btn-primary" type="button" data-attendance-save disabled>
      Guardar asistencias
    </button>
  </div>
</section>

<section class="panel is-hidden" data-attendance-history-view>
  <div class="section-title">
    <h2>Registro de asistencias</h2>
    <p>Historial filtrado. Acredita con ≥75%.</p>
  </div>

  <div class="filters-grid">
    <select data-history-filter-school aria-label="Escuela">
      <option value="">Todas las escuelas</option>
    </select>
    <select data-history-filter-course aria-label="Curso">
      <option value="">Todos los cursos</option>
    </select>
    <select data-history-filter-subject aria-label="Materia">
      <option value="">Todas las materias</option>
    </select>
    <input type="date" data-history-filter-from aria-label="Desde" />
    <input type="date" data-history-filter-to aria-label="Hasta" />
  </div>

  <section class="summary-strip" data-attendance-history-summary></section>

  <div class="section-title">
    <h3>Detalle por fecha</h3>
  </div>
  <div class="table-container" data-attendance-history-table></div>

  <div class="section-title">
    <h3>Promedio por alumno</h3>
    <p>Porcentaje de asistencia y estado de acreditación según los filtros.</p>
  </div>
  <div class="table-container" data-attendance-history-averages></div>

  <div class="section-title">
    <h3>Planilla del mes</h3>
    <p>Vista alumno × día. Ajustá el umbral de acreditación si tu escuela usa otro porcentaje.</p>
  </div>
  <div class="filters-grid" data-attendance-matrix-filters>
    <input type="month" data-attendance-matrix-month aria-label="Mes" />
    <label class="threshold-field">
      <span>Umbral % para acreditar</span>
      <input type="number" min="50" max="100" step="1" data-attendance-threshold aria-label="Umbral de asistencia" />
    </label>
    <button type="button" class="btn btn-secondary" data-attendance-matrix-export>Exportar planilla CSV</button>
  </div>
  <div class="table-container attendance-matrix-wrap" data-attendance-matrix></div>
</section>

<p class="tools-nav-link-wrap">
  {spaMode ? (
    <button type="button" class="tools-nav-link" data-tools-focus="excel" data-tools-tab="asistencias">
      ¿Tenés planilla Excel? Importá o exportá en Excel y cuenta →
    </button>
  ) : (
    <a class="tools-nav-link" href="/herramientas">¿Tenés planilla Excel? Importá o exportá en Excel y cuenta →</a>
  )}
</p>
