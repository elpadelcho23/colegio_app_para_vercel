---
import type { ExcelImportType } from '../lib/excel-import-limits';
import { EXCEL_IMPORT_LIMITS } from '../lib/excel-import-limits';
import {
  STUDENT_EXCEL_COLUMNS,
  STUDENT_EXCEL_EXAMPLE_ROWS,
  STUDENT_EXCEL_NOTES,
  STUDENT_EXCEL_SHEET,
} from '../lib/student-excel-reference';

interface Props {
  importType: 'alumnos' | 'asistencias' | 'notas';
  title?: string;
  description?: string;
  submitLabel?: string;
}

const defaultCopy = {
  alumnos: {
    title: 'Cargar alumnos desde Excel',
    description: 'Subí el archivo y confirmá las columnas.',
    submitLabel: 'Importar alumnos',
  },
  asistencias: {
    title: 'Cargar asistencias desde Excel',
    description: 'Subí la planilla y confirmá las columnas.',
    submitLabel: 'Importar asistencias',
  },
  notas: {
    title: 'Cargar notas desde Excel',
    description: 'Subí la planilla y confirmá las columnas.',
    submitLabel: 'Importar notas',
  },
} as const;

const {
  importType,
  title = defaultCopy[importType].title,
  description = defaultCopy[importType].description,
  submitLabel = defaultCopy[importType].submitLabel,
} = Astro.props;

const maxFileMb = Math.round(EXCEL_IMPORT_LIMITS.maxFileBytes / (1024 * 1024));

const studentExample = STUDENT_EXCEL_EXAMPLE_ROWS[0];

const attendanceColumns = [
  { label: 'Fecha', required: true, hint: 'AAAA-MM-DD o fecha de Excel', example: '2026-03-12' },
  { label: 'Colegio', required: true, hint: 'Nombre del colegio', example: 'Escuela Técnica 1' },
  { label: 'Curso', required: true, hint: 'División', example: '6to 1ra' },
  { label: 'Turno', required: true, hint: 'Mañana, Tarde o Noche', example: 'Mañana' },
  { label: 'Materia', required: true, hint: 'Se crea si no existe', example: 'Literatura' },
  { label: 'Alumno', required: true, hint: 'Nombre y apellido', example: 'Martina Ruiz' },
  { label: 'DNI', required: false, hint: 'Mejora el match', example: '44111222' },
  { label: 'Estado', required: true, hint: 'Presente, Ausente, P, A, Falta', example: 'Presente' },
];

const attendanceNotes = [
  'Podés usar tu propia planilla: mapeá cada columna y guardala como plantilla.',
  'Estado: Presente, Ausente, P, A, Falta.',
  'Fecha en AAAA-MM-DD o formato de Excel.',
  'DNI opcional mejora el match del alumno. La materia se crea si no existe.',
];

const gradeColumns = [
  { label: 'Fecha', required: true, hint: 'AAAA-MM-DD o fecha de Excel', example: '2026-03-12' },
  { label: 'Colegio', required: true, hint: 'Nombre del colegio', example: 'Escuela Técnica 1' },
  { label: 'Curso', required: true, hint: 'División', example: '6to 1ra' },
  { label: 'Turno', required: true, hint: 'Mañana, Tarde o Noche', example: 'Mañana' },
  { label: 'Materia', required: true, hint: 'Se crea si no existe', example: 'Literatura' },
  { label: 'Alumno', required: true, hint: 'Nombre y apellido', example: 'Martina Ruiz' },
  { label: 'DNI', required: false, hint: 'Mejora el match', example: '44111222' },
  { label: 'Evaluacion', required: true, hint: 'Nombre de la prueba', example: 'Parcial 1' },
  { label: 'Calificacion', required: true, hint: '1–10 o texto (S/C, Ausente…)', example: '8' },
];

const gradeNotes = [
  'Mapeá cada columna de tu planilla y guardá la plantilla para la próxima vez.',
  'Calificación: 1–10 o texto (S/C, Ausente…).',
  'DNI opcional mejora el match. La materia se crea si no existe.',
  'Columnas opcionales: Importancia, Entrega, Motivo, Tipo, Período.',
];

const attendanceExampleRows = [
  {
    Fecha: '2026-03-12',
    Colegio: 'Escuela Técnica 1',
    Curso: '6to 1ra',
    Turno: 'Mañana',
    Materia: 'Literatura',
    Alumno: 'Martina Ruiz',
    DNI: '44111222',
    Estado: 'Presente',
  },
  {
    Fecha: '2026-03-12',
    Colegio: 'Escuela Técnica 1',
    Curso: '6to 1ra',
    Turno: 'Mañana',
    Materia: 'Literatura',
    Alumno: 'Tomás Pereyra',
    DNI: '45222333',
    Estado: 'Ausente',
  },
];

const gradeExampleRows = [
  {
    Fecha: '2026-03-12',
    Colegio: 'Escuela Técnica 1',
    Curso: '6to 1ra',
    Turno: 'Mañana',
    Materia: 'Literatura',
    Alumno: 'Martina Ruiz',
    DNI: '44111222',
    Evaluacion: 'Parcial 1',
    Calificacion: '8',
  },
  {
    Fecha: '2026-03-12',
    Colegio: 'Escuela Técnica 1',
    Curso: '6to 1ra',
    Turno: 'Mañana',
    Materia: 'Literatura',
    Alumno: 'Tomás Pereyra',
    DNI: '45222333',
    Evaluacion: 'Parcial 1',
    Calificacion: '7',
  },
];
---

<section
  class="excel-workspace panel"
  data-excel-workspace
  data-import-type={importType}
  data-max-file-mb={maxFileMb}
>
  <div class="section-title">
    <h3>{title}</h3>
    <p>{description}</p>
  </div>

  <ol class="excel-workspace-steps" aria-label="Pasos de importación">
    <li class="excel-workspace-step is-active" data-excel-step="file">
      <span class="excel-workspace-step-num">1</span>
      <span class="excel-workspace-step-label">Subí el archivo</span>
    </li>
    <li class="excel-workspace-step" data-excel-step="columns">
      <span class="excel-workspace-step-num">2</span>
      <span class="excel-workspace-step-label">Confirmá columnas</span>
    </li>
  </ol>

  <div class="excel-toast is-hidden" data-excel-toast role="status" aria-live="polite"></div>

  <div class="excel-workspace-extras">
  <details class="excel-template-library" data-excel-template-library>
    <summary>
      <strong>Plantillas</strong>
      <span class="muted"> (opcional)</span>
    </summary>
    <div class="excel-template-library-head">
      <p class="muted">Usá un mapeo guardado.</p>
      <div class="excel-template-library-actions">
        <button type="button" class="btn btn-secondary btn-sm" data-excel-template-new>
          + Nueva plantilla
        </button>
        <a
          class="btn btn-ghost btn-sm"
          href={`/api/import/template?type=${importType}`}
          data-excel-download-example
        >Descargar ejemplo</a>
      </div>
    </div>
    <div class="excel-template-cards" data-excel-template-cards role="listbox" aria-label="Plantillas guardadas">
      <p class="excel-template-empty muted" data-excel-template-empty>
        Todavía no hay plantillas. Podés crear una después de mapear columnas.
      </p>
    </div>
  </details>

  {importType === 'alumnos' ? (
    <details class="excel-reference">
      <summary>
        <strong>Estructura</strong>
        <span class="muted"> (opcional)</span>
      </summary>
      <div class="section-title">
        <p>Hoja <strong>{STUDENT_EXCEL_SHEET}</strong> · podés usar otra estructura con plantilla personalizada.</p>
      </div>
      <div class="excel-reference-fields" aria-label="Columnas de referencia">
        {STUDENT_EXCEL_COLUMNS.map((column) => {
          const example = studentExample[column.label as keyof typeof studentExample];
          const hintLooksLikeExample = column.hint.toLowerCase().startsWith('ej:');
          return (
            <article class="excel-ref-field">
              <div class="excel-ref-field-head">
                <strong>{column.label}</strong>
                <span class={column.required ? 'excel-ref-tag excel-ref-tag-required' : 'excel-ref-tag excel-ref-tag-optional'}>
                  {column.required ? 'obligatorio' : 'opcional'}
                </span>
              </div>
              {!hintLooksLikeExample && <p class="excel-ref-field-hint">{column.hint}</p>}
              {example ? <p class="excel-ref-field-example">Ej: {example}</p> : hintLooksLikeExample && <p class="excel-ref-field-example">{column.hint}</p>}
            </article>
          );
        })}
      </div>
      <div class="table-container excel-reference-table" role="region" tabindex="0" aria-label="Ejemplo de hoja Excel de alumnos">
        <p class="excel-reference-scroll-hint" aria-hidden="true">Deslizá → para ver todas las columnas</p>
        <table>
          <thead>
            <tr>
              {STUDENT_EXCEL_COLUMNS.map((column) => (
                <th>
                  {column.label}
                  {column.required
                    ? <span class="excel-ref-tag excel-ref-tag-required">obligatorio</span>
                    : <span class="excel-ref-tag">opcional</span>}
                </th>
              ))}
            </tr>
          </thead>
          <tbody>
            {STUDENT_EXCEL_EXAMPLE_ROWS.slice(0, 2).map((row) => (
              <tr>
                {STUDENT_EXCEL_COLUMNS.map((column) => (
                  <td>{row[column.label as keyof typeof row] || '—'}</td>
                ))}
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="excel-table-scroll-hint muted">Deslizá hacia los costados para ver la tabla completa.</p>
      <ul class="import-requirements excel-reference-notes">
        {STUDENT_EXCEL_NOTES.slice(0, 4).map((note) => (
          <li>{note}</li>
        ))}
      </ul>
    </details>
  ) : importType === 'asistencias' ? (
    <details class="excel-reference">
      <summary>
        <strong>Columnas</strong>
        <span class="muted"> (opcional)</span>
      </summary>
      <div class="excel-reference-fields" aria-label="Columnas de referencia">
        {attendanceColumns.map((column) => (
          <article class="excel-ref-field">
            <div class="excel-ref-field-head">
              <strong>{column.label}</strong>
              <span class={column.required ? 'excel-ref-tag excel-ref-tag-required' : 'excel-ref-tag excel-ref-tag-optional'}>
                {column.required ? 'obligatorio' : 'opcional'}
              </span>
            </div>
            <p class="excel-ref-field-hint">{column.hint}</p>
            <p class="excel-ref-field-example">Ej: {column.example}</p>
          </article>
        ))}
      </div>
      <div class="table-container excel-reference-table" role="region" tabindex="0" aria-label="Ejemplo de hoja Excel de asistencias">
        <p class="excel-reference-scroll-hint" aria-hidden="true">Deslizá → para ver todas las columnas</p>
        <table>
          <thead>
            <tr>
              {attendanceColumns.map((column) => (
                <th>
                  {column.label}
                  {column.required
                    ? <span class="excel-ref-tag excel-ref-tag-required">obligatorio</span>
                    : <span class="excel-ref-tag">opcional</span>}
                </th>
              ))}
            </tr>
          </thead>
          <tbody>
            {attendanceExampleRows.map((row) => (
              <tr>
                {attendanceColumns.map((column) => (
                  <td>{row[column.label as keyof typeof row] || '—'}</td>
                ))}
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="excel-table-scroll-hint muted">Deslizá hacia los costados para ver la tabla completa.</p>
      <ul class="import-requirements excel-reference-notes">
        {attendanceNotes.map((note) => (
          <li>{note}</li>
        ))}
      </ul>
    </details>
  ) : (
    <details class="excel-reference">
      <summary>
        <strong>Columnas</strong>
        <span class="muted"> (opcional)</span>
      </summary>
      <div class="excel-reference-fields" aria-label="Columnas de referencia">
        {gradeColumns.map((column) => (
          <article class="excel-ref-field">
            <div class="excel-ref-field-head">
              <strong>{column.label}</strong>
              <span class={column.required ? 'excel-ref-tag excel-ref-tag-required' : 'excel-ref-tag excel-ref-tag-optional'}>
                {column.required ? 'obligatorio' : 'opcional'}
              </span>
            </div>
            <p class="excel-ref-field-hint">{column.hint}</p>
            <p class="excel-ref-field-example">Ej: {column.example}</p>
          </article>
        ))}
      </div>
      <div class="table-container excel-reference-table" role="region" tabindex="0" aria-label="Ejemplo de hoja Excel de notas">
        <p class="excel-reference-scroll-hint" aria-hidden="true">Deslizá → para ver todas las columnas</p>
        <table>
          <thead>
            <tr>
              {gradeColumns.map((column) => (
                <th>
                  {column.label}
                  {column.required
                    ? <span class="excel-ref-tag excel-ref-tag-required">obligatorio</span>
                    : <span class="excel-ref-tag">opcional</span>}
                </th>
              ))}
            </tr>
          </thead>
          <tbody>
            {gradeExampleRows.map((row) => (
              <tr>
                {gradeColumns.map((column) => (
                  <td>{row[column.label as keyof typeof row] || '—'}</td>
                ))}
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="excel-table-scroll-hint muted">Deslizá hacia los costados para ver la tabla completa.</p>
      <ul class="import-requirements excel-reference-notes">
        {gradeNotes.map((note) => (
          <li>{note}</li>
        ))}
      </ul>
    </details>
  )}
  </div>

  <section class="excel-template-builder is-hidden panel" data-excel-template-builder>
    <div class="section-title">
      <h4>Crear o editar plantilla</h4>
      <p>Escribí el nombre de cada columna como en tu Excel.</p>
    </div>
    <div class="form-grid excel-template-builder-form">
      <label class="full-width">
        <span>Nombre de la plantilla</span>
        <input type="text" data-excel-builder-name placeholder="Ej. Planilla colegio X - alumnos" />
      </label>
      <label>
        <span>Fila de encabezados</span>
        <input type="number" min="1" value="1" data-excel-builder-header-row />
      </label>
      <div class="excel-builder-fields full-width" data-excel-builder-fields></div>
      <div class="button-row full-width">
        <button type="button" class="btn btn-primary" data-excel-builder-save>Guardar plantilla</button>
        <button type="button" class="btn btn-ghost" data-excel-builder-cancel>Cancelar</button>
      </div>
    </div>
  </section>

  <form class="excel-workspace-form form-grid" data-excel-workspace-form>
    <div class="excel-dropzone full-width" data-excel-dropzone>
      <input
        type="file"
        name="archivo"
        class="excel-dropzone-input"
        accept=".xlsx,.xls,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet,application/vnd.ms-excel"
        data-excel-file
        required
      />
      <div class="excel-dropzone-body">
        <strong>Subí el archivo</strong>
        <span>Arrastrá o elegí · .xlsx / .xls · máx. {maxFileMb} MB</span>
        <span class="excel-dropzone-file muted" data-excel-dropzone-label>Sin archivo seleccionado</span>
      </div>
    </div>

    <div class="ai-file-feedback full-width is-hidden" data-excel-feedback aria-live="polite"></div>

    <section class="excel-mapping full-width is-hidden" data-excel-mapping-panel>
      <div class="excel-mapping-head">
        <div class="section-title">
          <h4>Confirmá columnas</h4>
          <p>Elegí qué es cada columna (Nombre, Curso, etc.).</p>
        </div>
        <div class="excel-mapping-progress" data-excel-mapping-progress aria-live="polite">
          <span data-excel-mapping-progress-text>0 de 0 obligatorios</span>
          <div class="excel-mapping-progress-bar"><span data-excel-mapping-progress-fill></span></div>
        </div>
      </div>

      <div class="excel-detected-headers is-hidden" data-excel-detected-headers>
        <span class="excel-detected-label">Columnas detectadas:</span>
        <div class="excel-header-chips" data-excel-header-chips></div>
      </div>

      <div class="excel-mapping-toolbar">
        <label>
          <span>Fila de encabezados</span>
          <input type="number" min="1" value="1" data-excel-header-row />
        </label>
        <label>
          <span>Hoja usada</span>
          <input type="text" readonly data-excel-sheet-name value="—" aria-label="Hoja de Excel detectada" />
        </label>
        <button class="btn btn-ghost" type="button" data-excel-ai-map title="Opcional: pedile a la IA que proponga columnas">
          Reconocer con IA (opcional)
        </button>
      </div>
      <p class="muted excel-ai-map-hint" data-excel-ai-map-hint hidden></p>

      <div class="excel-mapping-table" data-excel-mapping-fields></div>

      <div class="excel-save-template-cta is-hidden" data-excel-save-cta>
        <p>¿Querés reutilizar este mapeo la próxima vez?</p>
        <div class="excel-mapping-templates">
          <input
            type="text"
            data-excel-template-name
            placeholder="Nombre de plantilla (ej. Planilla colegio X)"
            aria-label="Nombre de plantilla"
          />
          <button class="btn btn-secondary" type="button" data-excel-template-save>Guardar plantilla</button>
        </div>
      </div>

      <details class="excel-mapping-advanced">
        <summary>Opciones avanzadas</summary>
        <div class="button-row">
          <button class="btn btn-ghost btn-sm" type="button" data-excel-template-edit>Editar plantilla actual</button>
          <button class="btn btn-ghost btn-sm" type="button" data-excel-template-duplicate>Duplicar</button>
          <button class="btn btn-ghost btn-sm" type="button" data-excel-template-delete>Eliminar</button>
        </div>
      </details>
    </section>

    <section class="excel-preview-panel full-width is-hidden" data-excel-preview-panel>
      <div class="section-title">
        <h4>Vista previa</h4>
      </div>
      <div class="import-result" data-excel-preview hidden></div>
      <div class="table-container excel-preview-table is-hidden" data-excel-preview-table></div>
    </section>

    <div class="import-result full-width" data-excel-result hidden></div>

    <div class="button-row full-width">
      <button class="btn btn-primary" type="submit" data-excel-submit disabled>{submitLabel}</button>
    </div>
  </form>
</section>
