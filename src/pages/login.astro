---
import '../styles/global.css';
const error = Astro.url.searchParams.get('error');
const registered = Astro.url.searchParams.get('registered');
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="theme-color" content="#226c5f" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/pwa-icon.svg" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700;800;900&display=swap"
      rel="stylesheet"
    />
    <title>Login | Aula Clara</title>
    <script is:inline>
      document.documentElement.dataset.theme =
        localStorage.getItem('aula_clara_theme') || 'light';

      (function () {
        var keep = { aula_clara_theme: 1, aula_clara_offline_reset_v2: 1 };
        var remove = [];
        for (var i = 0; i < localStorage.length; i++) {
          var key = localStorage.key(i);
          if (!key || keep[key]) continue;
          if (key.indexOf('aula_clara_') === 0 || key.indexOf(':guest-') !== -1) {
            remove.push(key);
          }
        }
        remove.forEach(function (key) { localStorage.removeItem(key); });
        try {
          ['aula_clara_recovery_draft','aula_clara_curriculum_context','aula_clara_ai_extra_prompt','aula_clara_has_activity']
            .forEach(function (key) { sessionStorage.removeItem(key); });
        } catch (e) {}
      })();
    </script>
  </head>
  <body class="auth-body">
    <main class="auth-container">
      <section class="auth-card">
        <header class="auth-header">
          <p class="eyebrow">Acceso seguro</p>
          <h1>Aula Clara</h1>
          <p class="muted">Ingresá con tu cuenta docente o admin.</p>
        </header>

        {registered && <p class="tag ok auth-alert">Cuenta creada. Ahora podés iniciar sesión.</p>}
        {error && <p class="tag danger auth-alert">Credenciales inválidas</p>}

        <form method="post" action="/api/auth/login" class="auth-form">
          <label>
            <span>Email</span>
            <input
              type="email"
              name="email"
              placeholder="usuario@ejemplo.com"
              autocomplete="email"
              required
            />
          </label>
          <label>
            <span>Contraseña</span>
            <input
              type="password"
              name="password"
              placeholder="********"
              autocomplete="current-password"
              required
            />
          </label>
          <button class="btn btn-primary btn-block" type="submit">Entrar</button>
        </form>

        <div class="auth-divider" role="separator">
          <span>o</span>
        </div>

        <form method="post" action="/api/auth/guest" class="auth-form auth-guest-form">
          <button class="btn btn-secondary btn-block" type="submit">Probar sin cuenta</button>
          <p class="muted auth-guest-hint">Modo invitado: probá la app completa (cursos de ejemplo, clase virtual e IA; sin alumnos precargados). Al salir se borran los datos — creá una cuenta para guardarlos.</p>
        </form>

        <section class="pwa-install auth-pwa-install" data-pwa-install>
          <div class="section-title">
            <h2>Instalar en PC o Android</h2>
            <p>Dejá Aula Clara como app en tu dispositivo. No es una extensión de tienda: se instala desde esta web.</p>
          </div>
          <button type="button" class="btn btn-primary btn-block" data-pwa-install-btn>
            Instalar app
          </button>
          <p class="muted" data-pwa-install-status></p>
          <details class="pwa-install-help" data-pwa-install-help>
            <summary>Cómo instalar según el dispositivo</summary>
            <ul>
              <li><strong>Android (Chrome):</strong> tocá Instalar, o Menú ⋮ → Instalar app.</li>
              <li><strong>PC (Chrome / Edge):</strong> tocá Instalar, o el ícono ⊕ en la barra de direcciones.</li>
              <li><strong>iPhone / iPad (Safari):</strong> Compartir → Agregar a pantalla de inicio.</li>
            </ul>
          </details>
        </section>

        <footer class="auth-footer">
          <p>¿No tenés cuenta? <a href="/register">Registrate acá</a>.</p>
        </footer>
      </section>
    </main>
    <script>
      import { registerSW } from 'virtual:pwa-register';
      import { initPwaInstall } from '../scripts/pwa-install.js';

      registerSW({ immediate: true });
      initPwaInstall();
    </script>
  </body>
</html>
