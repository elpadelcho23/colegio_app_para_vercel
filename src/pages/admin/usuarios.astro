---
import Layout from '../../layouts/Layout.astro';
import { listBackups } from '../../server/backup';
import { db } from '../../server/db';
import { listTeachersForInstitutionAdmin } from '../../server/institution-teachers';

const currentUser = Astro.locals.user;
const auth = Astro.locals.auth;
if (!currentUser || !auth || auth.role !== 'admin') {
  return Astro.redirect('/');
}

const tenantId = auth.tenantId;

const listed = await listTeachersForInstitutionAdmin(currentUser);
const teachers = listed.ok ? listed.teachers : [];

const cursos = (await db.prepare(`
  SELECT id, escuela, nombre, turno
  FROM cursos
  WHERE tenant_id = ?
  ORDER BY escuela, nombre
`).all(tenantId)) as Array<{ id: string; escuela: string; nombre: string; turno: string }>;

const materias = (await db.prepare(`
  SELECT id, nombre
  FROM materias
  WHERE activo = 1 AND tenant_id = ?
  ORDER BY nombre
`).all(tenantId)) as Array<{ id: string; nombre: string }>;

const backups = listBackups();

const flashOk = Astro.url.searchParams.get('ok');
const flashError = Astro.url.searchParams.get('error');
const flashMessage = flashOk === 'teacher'
  ? 'Docente agregado correctamente.'
  : flashOk === 'revoked'
    ? 'Membership de docente revocada.'
    : flashOk === 'reactivated'
      ? 'Docente reactivado.'
      : flashError === 'conflict'
        ? 'Ese email ya pertenece activamente a esta institución.'
        : flashError === 'needs_reactivation'
          ? 'Ese docente ya tiene membership revocada: usá Reactivar.'
          : flashError === 'validation'
            ? 'Datos inválidos. Revisá nombre, email y contraseña.'
            : flashError
              ? 'No se pudo completar la operación.'
              : null;
---

<Layout title="Administración">
  <main class="page page-stack">
    <header class="page-header">
      <div>
        <p class="eyebrow">Administración institucional</p>
        <h1>Docentes y respaldos</h1>
        <p>Gestión de docentes de tu institución: alta, estado, revocación y reactivación.</p>
      </div>
      <div class="button-row">
        <a class="btn btn-secondary" href="/admin/institucion">Configuración</a>
        <a class="btn btn-secondary" href="/">Volver al panel</a>
      </div>
    </header>

    {flashMessage && (
      <p class={`notice ${flashError ? 'notice-error' : 'notice-ok'}`} role="status">
        {flashMessage}
      </p>
    )}

    <section class="grid-2">
      <form class="panel form-grid" method="post" action="/api/admin/teachers">
        <div class="section-title span-2">
          <h2>Agregar docente</h2>
          <p>Se crea en tu institución (sin tenant nuevo). Si omitís la contraseña, se envía un enlace de restablecimiento.</p>
        </div>
        <label>
          <span>Nombre</span>
          <input name="nombre" required />
        </label>
        <label>
          <span>Email</span>
          <input type="email" name="email" required />
        </label>
        <label class="span-2">
          <span>Contraseña temporal (opcional)</span>
          <input type="password" name="password" minlength="5" autocomplete="new-password" />
        </label>
        <fieldset class="span-2 checkbox-grid">
          <legend>Cursos asignados</legend>
          {cursos.map((curso) => (
            <label>
              <input type="checkbox" name="cursoIds" value={curso.id} />
              <span>{curso.escuela} - {curso.nombre} - {curso.turno}</span>
            </label>
          ))}
        </fieldset>
        <fieldset class="span-2 checkbox-grid">
          <legend>Materias asignadas</legend>
          {materias.map((materia) => (
            <label>
              <input type="checkbox" name="materiaIds" value={materia.id} />
              <span>{materia.nombre}</span>
            </label>
          ))}
        </fieldset>
        <button class="btn btn-primary span-2" type="submit">Agregar docente</button>
      </form>

      <div class="panel">
        <div class="section-title">
          <h2>Docentes de la institución</h2>
          <p>Memberships con rol docente en tu tenant activo.</p>
        </div>
        <div class="table-wrap">
          <table>
            <thead>
              <tr>
                <th>Nombre</th>
                <th>Email</th>
                <th>Estado</th>
                <th>Alta</th>
                <th>Acción</th>
              </tr>
            </thead>
            <tbody>
              {teachers.length === 0 && (
                <tr>
                  <td colspan="5">Todavía no hay docentes en esta institución.</td>
                </tr>
              )}
              {teachers.map((teacher) => (
                <tr>
                  <td data-label="Nombre">{teacher.nombre}</td>
                  <td data-label="Email">{teacher.email}</td>
                  <td data-label="Estado">
                    <span class={`tag ${teacher.status === 'active' ? 'tag-ok' : 'tag-muted'}`}>
                      {teacher.status}
                    </span>
                    {teacher.revoked_at && (
                      <span class="muted-inline"> · revocado {new Date(teacher.revoked_at).toLocaleDateString('es-AR')}</span>
                    )}
                  </td>
                  <td data-label="Alta">{teacher.created_at ? new Date(teacher.created_at).toLocaleDateString('es-AR') : '—'}</td>
                  <td data-label="Acción">
                    {teacher.status === 'active' ? (
                      <form method="post" action="/api/admin/teachers/revoke" onsubmit="return confirm('¿Revocar acceso de este docente a la institución?')">
                        <input type="hidden" name="membershipId" value={teacher.membershipId} />
                        <button class="btn btn-danger" type="submit">Revocar</button>
                      </form>
                    ) : (
                      <form method="post" action="/api/admin/teachers/reactivate">
                        <input type="hidden" name="membershipId" value={teacher.membershipId} />
                        <button class="btn btn-secondary" type="submit">Reactivar</button>
                      </form>
                    )}
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <section class="panel institutional-panel">
      <div class="section-title">
        <h2>Backups SQLite</h2>
        <p>Se generan automáticamente y también pueden crearse antes de operaciones sensibles.</p>
      </div>
      <form method="post" action="/api/admin/backup/create" class="button-row">
        <button class="btn btn-primary" type="submit">Crear backup ahora</button>
      </form>
      <div class="table-wrap">
        <table>
          <thead>
            <tr><th>Archivo</th><th>Fecha</th><th>Tamaño</th><th>Restaurar</th></tr>
          </thead>
          <tbody>
            {backups.map((backup) => (
              <tr>
                <td data-label="Archivo">{backup.name}</td>
                <td data-label="Fecha">{new Date(backup.createdAt).toLocaleString('es-AR')}</td>
                <td data-label="Tamaño">{Math.round(backup.size / 1024)} KB</td>
                <td data-label="Restaurar">
                  <form method="post" action="/api/admin/backup/restore" onsubmit="return confirm('Restaurar este backup reemplazará los datos actuales. Se creará un backup previo automáticamente. ¿Continuar?')">
                    <input type="hidden" name="name" value={backup.name} />
                    <button class="btn btn-danger" type="submit">Restaurar</button>
                  </form>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>
  </main>
</Layout>

<style>
  .notice {
    margin: 0;
    padding: 0.85rem 1rem;
    border-radius: 10px;
    border: 1px solid transparent;
  }
  .notice-ok {
    background: color-mix(in srgb, var(--color-primary, #226c5f) 12%, white);
    border-color: color-mix(in srgb, var(--color-primary, #226c5f) 28%, white);
  }
  .notice-error {
    background: color-mix(in srgb, #b42318 10%, white);
    border-color: color-mix(in srgb, #b42318 28%, white);
  }
  .tag-ok {
    background: color-mix(in srgb, var(--color-primary, #226c5f) 16%, white);
  }
  .tag-muted {
    opacity: 0.8;
  }
  .muted-inline {
    color: var(--color-muted, #667);
    font-size: 0.85em;
  }
</style>
