---
import '../styles/global.css';

const token = Astro.url.searchParams.get('token') || '';
const status = Astro.url.searchParams.get('status') || '';
const canReset = Boolean(token) && !['missing', 'invalid', 'expired', 'used'].includes(status);

const statusMessage: Record<string, string> = {
  missing: 'Falta el enlace de recuperación. Pedí uno nuevo.',
  invalid: 'El enlace no es válido. Pedí uno nuevo.',
  expired: 'El enlace venció. Pedí uno nuevo.',
  used: 'Este enlace ya fue usado. Pedí uno nuevo.',
  mismatch: 'Las contraseñas no coinciden.',
  weak: 'La contraseña debe tener al menos 5 caracteres, con letras y números.',
};
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="theme-color" content="#226c5f" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700;800;900&display=swap"
      rel="stylesheet"
    />
    <title>Nueva contraseña | Aula Clara</title>
    <script is:inline>
      document.documentElement.dataset.theme =
        localStorage.getItem('aula_clara_theme') || 'light';
    </script>
  </head>
  <body class="auth-body">
    <main class="auth-container">
      <section class="auth-card">
        <header class="auth-header">
          <p class="eyebrow">Seguridad</p>
          <h1>Elegí una nueva contraseña</h1>
          <p class="muted">Después de cambiarla, las sesiones anteriores se cierran.</p>
        </header>

        {status && statusMessage[status] && (
          <p class="tag danger auth-alert">{statusMessage[status]}</p>
        )}

        {canReset ? (
          <form method="post" action="/api/auth/reset-password" class="auth-form">
            <input type="hidden" name="token" value={token} />
            <label>
              <span>Nueva contraseña</span>
              <input type="password" name="password" autocomplete="new-password" minlength="5" required />
              <small>Mínimo 5 caracteres, con letras y números.</small>
            </label>
            <label>
              <span>Confirmar contraseña</span>
              <input type="password" name="confirm" autocomplete="new-password" minlength="5" required />
            </label>
            <button class="btn btn-primary btn-block" type="submit">Guardar contraseña</button>
          </form>
        ) : (
          <p class="muted">
            Pedí un nuevo enlace desde <a href="/forgot-password">recuperar contraseña</a>.
          </p>
        )}

        <footer class="auth-footer">
          <p><a href="/login">Volver al login</a></p>
        </footer>
      </section>
    </main>
  </body>
</html>
