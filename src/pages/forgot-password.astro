---
import '../styles/global.css';
const sent = Astro.url.searchParams.get('sent');
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="theme-color" content="#226c5f" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700;800;900&display=swap"
      rel="stylesheet"
    />
    <title>Recuperar contraseña | Aula Clara</title>
    <script is:inline>
      document.documentElement.dataset.theme =
        localStorage.getItem('aula_clara_theme') || 'light';
    </script>
  </head>
  <body class="auth-body">
    <main class="auth-container">
      <section class="auth-card">
        <header class="auth-header">
          <p class="eyebrow">Recuperación</p>
          <h1>¿Olvidaste tu contraseña?</h1>
          <p class="muted">Te enviamos un enlace seguro si el email está registrado.</p>
        </header>

        {sent ? (
          <p class="tag ok auth-alert">
            Si el email está registrado, te enviamos un enlace para restablecer la contraseña.
            Revisá tu bandeja (y spam).
          </p>
        ) : (
          <form method="post" action="/api/auth/forgot-password" class="auth-form">
            <label>
              <span>Email</span>
              <input type="email" name="email" autocomplete="email" required />
            </label>
            <button class="btn btn-primary btn-block" type="submit">Enviar enlace</button>
          </form>
        )}

        <footer class="auth-footer">
          <p><a href="/login">Volver al login</a></p>
        </footer>
      </section>
    </main>
  </body>
</html>
