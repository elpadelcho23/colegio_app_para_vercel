---
import Navigation from '../components/Navigation.astro';
import AppShell from '../components/spa/AppShell.astro';
import '../styles/global.css';
import { resolveInitialView, type SpaViewId } from '../scripts/spa-config.ts';

interface Props {
  title: string;
  description?: string;
  useSpa?: boolean;
}

const {
  title,
  description = 'Gestion escolar para docentes: asistencia, notas y seguimiento academico.',
  useSpa,
} = Astro.props;

const currentPath = Astro.url.pathname;
const user = Astro.locals.user;
const isAdminPage = currentPath.startsWith('/admin');
const spaEnabled = useSpa ?? Boolean(user && !isAdminPage);
const initialView = spaEnabled
  ? resolveInitialView(currentPath, Astro.url.search)
  : 'panel';
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#226c5f" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/pwa-icon.svg" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700;800;900&display=swap"
      rel="stylesheet"
    />
    {spaEnabled && (
      <link
        rel="stylesheet"
        href="https://cdn.jsdelivr.net/npm/katex@0.16.11/dist/katex.min.css"
        crossorigin="anonymous"
      />
    )}
    <title>{title} | Aula Clara</title>
    <slot name="head" />
  </head>
  <body class="app-body" data-spa-enabled={spaEnabled ? 'true' : 'false'}>
    <a class="skip-link" href="#main-content">Ir al contenido principal</a>
    <Navigation currentPath={currentPath} spaEnabled={spaEnabled} />
    <div class="app-main" id="main-content">
      {spaEnabled ? (
        <AppShell initialView={initialView as SpaViewId} />
      ) : (
        <slot />
      )}
    </div>
    <div
      class="app-toast is-hidden"
      data-app-toast
      role="status"
      aria-live="polite"
      aria-atomic="true"
      hidden
    ></div>
    <script define:vars={{ user, initialView, spaEnabled }}>
      window.__AULA_CLARA_USER__ = user
        ? {
            id: user.id,
            tenant_id: user.tenant_id,
            nombre: user.nombre,
            email: user.email,
            rol: user.rol,
            isGuest: Boolean(user.is_guest),
          }
        : null;
      window.__AULA_CLARA_SPA__ = { enabled: spaEnabled, initialView };
    </script>
    <script>
      import '../scripts/school-app.js';
    </script>
    <script>
      import { registerSW } from 'virtual:pwa-register';

      registerSW({
        immediate: true,
        onOfflineReady() {
          console.info('[aula-clara] La app está lista para usarse sin conexión.');
        },
      });
    </script>
  </body>
</html>
