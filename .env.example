# Copiá este archivo a .env y completá los valores (no subas .env al repositorio).
# En Vercel: Project Settings → Environment Variables (Production + Preview).

GROQ_API_KEY=

# Secreto para firmar la sesión (passport) entre instancias de Vercel (recomendado)
AUTH_SECRET=

# Base de datos durable (obligatorio en Vercel). Sin esto, en local usa file:.data/aula-clara.sqlite
# Crear DB: https://turso.tech → turso db create aula-clara
# URL:     turso db show aula-clara --url
# Token:   turso db tokens create aula-clara
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Límites opcionales para la cola de solicitudes a Groq (50 docentes concurrentes)
GROQ_MAX_CONCURRENT=6
GROQ_MAX_RPM=28

# Intervalo de backups automáticos locales (horas). No aplica con Turso remoto.
BACKUP_INTERVAL_HOURS=24
